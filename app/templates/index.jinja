{% extends "_modele.jinja" %}

{%block centered_title %}
<div class="hero pb-3">
    <h1 class="display-5 fw-bold mb-3">Trouvez une place de stationnement,<br>près de chez vous.</h1>
    <p class="mb-4">Louez des espaces de stationnement privés, simplement et en toute confiance.</p>
    <form action="/publications/recherche" method="get" id="research"
        class="bg-white rounded-3 p-1 mx-auto shadow needs-validation" style="max-width: 1100px;" novalidate>
        <div class="row g-2 align-items-center">
            <div class="col-md-2">
                <div class="input-group border-end">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-geo-alt"></i></span>
                    <select id="ville" name="ville" class="form-select {{classe_ville}} border-0 ">
                        <option selected value="">Choisissez la ville</option>
                        <option {% if ville=="Montréal" %}selected{% endif %}>Montréal</option>
                        <option {% if ville=="Québec" %}selected{% endif %}>Québec</option>
                        <option {% if ville=="Laval" %}selected{% endif %}>Laval</option>
                        <option {% if ville=="Gatineau" %}selected{% endif %}>Gatineau</option>
                        <option {% if ville=="Longueuil" %}selected{% endif %}>Longueuil</option>
                        <option {% if ville=="Sherbrooke" %}selected{% endif %}>Sherbrooke</option>
                        <option {% if ville=="Lévis" %}selected{% endif %}>Lévis</option>
                        <option {% if ville=="Saguenay" %}selected{% endif %}>Saguenay</option>
                        <option {% if ville=="Trois-Rivières" %}selected{% endif %}>Trois-Rivières</option>
                        <option {% if ville=="Terrebonne" %}selected{% endif %}>Terrebonne</option>
                        <option {% if ville=="Saint-Jean-sur-Richelieu" %}selected{% endif %}>
                            Saint-Jean-sur-Richelieu</option>
                        <option {% if ville=="Brossard" %}selected{% endif %}>Brossard</option>
                        <option {% if ville=="Repentigny" %}selected{% endif %}>Repentigny</option>
                        <option {% if ville=="Saint-Jérôme" %}selected{% endif %}>Saint-Jérôme</option>
                        <option {% if ville=="Drummondville" %}selected{% endif %}>Drummondville</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3 broder border-end">
                <input name="debut" type="datetime-local" class="form-control border-0" aria-label="Date de début">
            </div>
            <div class="col-md-3">
                <input name="fin" type="datetime-local" class="form-control border-0" aria-label="Date de fin">
                <div class="invalid-feedback">{{context.time_message}}</div>
            </div>
            <div class="col-md-2 border-0">
                <select class="form-select" name="filter">
                    <option selected value="Tous">Tous</option>
                    <option value="Intérieur">Intérieur</option>
                    <option value="Extérieur">Extérieur</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button id="submit_btn" type="submit" class="bi bi-search btn btn-dark"> Rechercher</button>
            </div>
        </div>
    </form>
</div>
{%endblock%}
{% block recherche %}
{% endblock %}

{% block contenu %}
<div class="container mt-2">
    <div class="d-flex align-items-center justify-content-between">
        <p class="fs-4 fw-bold">Annonces du moment</p>
        <a href="{{url_for('publications.index', page=1)}}" class="link-underline link-underline-opacity-0 text-black">
            <p class="fs-6">Voir toutes les publications →</p>
        </a>
    </div>


<ul class="list-unstyled row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">

    {% set path = "/static/img/stationnement/" %}

    {% for item in context.publications %}

    <li class="col d-flex">

        <a href="{{ url_for('stationnement.detail', publication_id=item.id) }}"
           class="text-decoration-none text-dark w-100">

            <div class="card h-100 shadow-sm overflow-hidden">

                <img
                    src="{% if item.img %}{{ path ~ item.img }}{% else %}{{ url_for('static', filename='img/placeholder.jpg') }}{% endif %}"
                    class="card-img-top"
                    alt="Photo du stationnement"
                    style="height: 170px; object-fit: cover;">

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title fw-bold fs-6">
                        {{ item.address }}, {{ item.city }}
                    </h5>

                    <p class="fw-bold mb-2">
                        {{ item.price }} $
                        <span class="fw-normal text-muted">/heure</span>
                    </p>

                    <div class="mt-auto">

                        <p class="card-text small text-muted mb-2">
                            <i class="bi bi-house me-1"></i>
                            {{ item.location }}
                        </p>

                        <p class="card-text small text-muted mb-2">
                            <i class="bi bi-geo-alt me-1"></i>
                            {{ item.place_total }} place(s)
                        </p>

                        <span class="badge bg-secondary">
                            Voir les disponibilités
                        </span>

                    </div>

                </div>

            </div>

        </a>

    </li>

    {% endfor %}

</ul>

</div>
{% endblock %}

{%block section_how %}
<section id="how" class="bg-light py-5 text-center">
    <div>
        <h2 class="fw-bold mb-5">Comment ça marche ?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <h2 class="bi bi-1-circle-fill"></h2>
                <h3 class="h6 fw-bold">Recherchez</h3>
                <p class="small text-muted mx-auto" style="max-width:230px">Trouvez une place selon vos besoins
                    et vos critères.</p>
            </div>
            <div class="col-md-4">
                <h2 class="bi bi-2-circle-fill"></h2>
                <h3 class="h6 fw-bold">Réservez</h3>
                <p class="small text-muted mx-auto" style="max-width:230px">Choisissez une période et confirmez
                    votre réservation.</p>
            </div>
            <div class="col-md-4">
                <h2 class="bi bi-3-circle-fill"></h2>
                <h3 class="h6 fw-bold">Stationnez</h3>
                <p class="small text-muted mx-auto" style="max-width:230px">Profitez de votre place en toute
                    tranquillité.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}