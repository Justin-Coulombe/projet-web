{% extends "_modele.jinja" %}

{%block centered_title %}
<div class="mx-auto p-2" style="width: 350px;">
  <h1>Bienvenue sur <b>PARKSHARE</b> </h1>
</div>
{%endblock%}

{% block contenu %}
<div class="container">
    <div class="d-flex align-items-center justify-content-between">
        <p class="fs-4 fw-bold">Annonces du moment</p>
        <a href="/publications" class="link-underline link-underline-opacity-0 text-black">
            <p class="fs-6">Voir toutes les publications →</p>
        </a>
    </div>

    <div class="row gap-2">
        {% for item in context.publications%}
        <div class="card col-2">
            <img class="card-img-top" src="{% if item.image %}  {%else%} {{url_for('static', filename='img/placeholder.jpg')}} {%endif%}" alt="photo de la place">
            <div class="card-body">
                <p class="card-text">
                    <b>{{item.price}}$/h</b><br>
                    {{item.address}}, {{item.city}}
                </p>
            </div>
        </div>
        {%endfor%}
    </div>
</div>
{% endblock %}