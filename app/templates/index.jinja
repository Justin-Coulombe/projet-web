
{% extends "_modele.jinja" %}

{% block title %}
Accueil | ParkShare
{% endblock %}

{% block body_class %}ps-home-page{% endblock %}

{% block page_layout %}

{% set publications = context.publications | default([]) %}
{% set image_fallback = url_for('static', filename='img/placeholder.jpg') %}

<div class="ps-home">

    <section class="ps-home-hero-section">
        <div class="container-fluid ps-site-shell">

            <div class="ps-home-hero">

                <div class="ps-home-hero-content">

                    <span class="ps-home-eyebrow">
                        Le stationnement, en mieux.
                    </span>

                    <h1>
                        Moins de tours.<br>
                        Plus de détours<br>
                        qui en valent la peine.
                    </h1>

                    <p class="ps-home-hero-description">
                        Trouvez une place près de chez vous.<br>
                        Louez des espaces privés, simplement<br>
                        et en toute confiance.
                    </p>

                </div>

                <div class="ps-home-hero-media">

                    {% if publications and publications[0].img %}
                        <img
                            src="{{ url_for('static', filename='img/stationnement/' ~ publications[0].img) }}"
                            alt="Stationnement privé près d'un immeuble"
                            class="ps-home-hero-image">
                    {% else %}
                        <img
                            src="{{ image_fallback }}"
                            alt="Stationnement"
                            class="ps-home-hero-image">
                    {% endif %}

                    <span class="ps-home-hero-caption">
                        Pensé pour les villes du Québec
                    </span>

                </div>

            </div>

            <div class="ps-home-search-wrapper">

                <form
                    action="{{ url_for('publications.recherche') if false else '/publications/recherche' }}"
                    method="GET"
                    id="research"
                    class="ps-home-search needs-validation"
                    novalidate>

                    <div class="ps-home-search-grid">

                        <div class="ps-home-search-field">

                            <label for="ville" class="form-label">
                                Où allez-vous ?
                            </label>

                            <select
                                id="ville"
                                name="ville"
                                class="form-select {{ classe_ville | default('') }}">

                                <option value="" selected>
                                    Choisir une ville
                                </option>

                                {% for nom_ville in [
                                    "Montréal",
                                    "Québec",
                                    "Laval",
                                    "Gatineau",
                                    "Longueuil",
                                    "Sherbrooke",
                                    "Lévis",
                                    "Saguenay",
                                    "Trois-Rivières",
                                    "Terrebonne",
                                    "Saint-Jean-sur-Richelieu",
                                    "Brossard",
                                    "Repentigny",
                                    "Saint-Jérôme",
                                    "Drummondville"
                                ] %}

                                    <option
                                        value="{{ nom_ville }}"
                                        {% if ville is defined and ville == nom_ville %}
                                            selected
                                        {% endif %}>
                                        {{ nom_ville }}
                                    </option>

                                {% endfor %}

                            </select>

                        </div>

                        <div class="ps-home-search-field">

                            <label for="debut" class="form-label">
                                Arrivée
                            </label>

                            <input
                                type="datetime-local"
                                id="debut"
                                name="debut"
                                class="form-control"
                                aria-label="Date et heure d'arrivée">

                        </div>

                        <div class="ps-home-search-field">

                            <label for="fin" class="form-label">
                                Départ
                            </label>

                            <input
                                type="datetime-local"
                                id="fin"
                                name="fin"
                                class="form-control"
                                aria-label="Date et heure de départ">

                            <div class="invalid-feedback">
                                {{ context.time_message | default('') }}
                            </div>

                        </div>

                        <div class="ps-home-search-field">

                            <label for="filter" class="form-label">
                                Emplacement
                            </label>

                            <select
                                id="filter"
                                name="filter"
                                class="form-select">

                                <option value="Tous" selected>
                                    Tous
                                </option>

                                <option value="Intérieur">
                                    Intérieur
                                </option>

                                <option value="Extérieur">
                                    Extérieur
                                </option>

                            </select>

                        </div>

                        <div class="ps-home-search-submit">

                            <button
                                id="submit_btn"
                                type="submit"
                                class="btn ps-home-search-button">

                                Rechercher

                                <i
                                    class="bi bi-arrow-up-right ms-1"
                                    aria-hidden="true"></i>

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>
    </section>


    <section class="ps-home-listings">

        <div class="container-fluid ps-site-shell">

            <div class="ps-home-section-heading">

                <div>
                    <h2>Votre place vous attend.</h2>

                    <p>
                        Quelques stationnements à découvrir
                        dans votre ville.
                    </p>
                </div>

                <a
                    href="{{ url_for('publications.index', page=1) }}"
                    class="ps-home-section-link">

                    Toutes les annonces

                    <i
                        class="bi bi-arrow-up-right"
                        aria-hidden="true"></i>

                </a>

            </div>

            {% if publications %}

                <div class="row g-4">

                    {% for item in publications[:3] %}

                        <div class="col-12 col-md-6 col-lg-4 d-flex">

                            <a
                                href="{{ url_for('stationnement.detail', publication_id=item.id) }}"
                                class="ps-home-parking-card">

                                <div class="ps-home-parking-image-wrapper">

                                    {% if item.img %}
                                        <img
                                            src="{{ url_for('static', filename='img/stationnement/' ~ item.img) }}"
                                            alt="Stationnement situé au {{ item.address }}"
                                            class="ps-home-parking-image"
                                            loading="lazy">
                                    {% else %}
                                        <img
                                            src="{{ image_fallback }}"
                                            alt="Photo non disponible"
                                            class="ps-home-parking-image"
                                            loading="lazy">
                                    {% endif %}

                                </div>

                                <div class="ps-home-parking-body">

                                    <span class="ps-home-parking-city">
                                        {{ item.city }}
                                    </span>

                                    <h3 class="ps-home-parking-address">
                                        {{ item.address }}
                                    </h3>

                                    <p class="ps-home-parking-meta">

                                        {{ item.location }}

                                        <span aria-hidden="true">·</span>

                                        {{ item.place_total }}
                                        place{% if item.place_total | int != 1 %}s{% endif %}

                                    </p>

                                    <div class="ps-home-parking-footer">

                                        <div class="ps-home-parking-price">

                                            <strong>
                                                {{ "%.2f" | format(item.price | float) | replace(".", ",") }} $
                                            </strong>

                                            <span>/ heure</span>

                                        </div>

                                        <span class="ps-home-parking-action">
                                            Voir l'annonce
                                            <i
                                                class="bi bi-arrow-up-right"
                                                aria-hidden="true"></i>
                                        </span>

                                    </div>

                                </div>

                            </a>

                        </div>

                    {% endfor %}

                </div>

            {% else %}

                <div class="ps-home-empty">
                    <i class="bi bi-p-square"></i>

                    <h3>Aucune annonce pour le moment</h3>

                    <p>
                        Revenez bientôt découvrir
                        de nouveaux stationnements.
                    </p>
                </div>

            {% endif %}

        </div>

    </section>


    <section id="how" class="ps-home-how-section">

        <div class="container-fluid ps-site-shell">

            <div class="ps-home-how">

                <h2>Une place. Trois étapes.</h2>

                <div class="row g-4 g-lg-5">

                    <div class="col-12 col-md-4">

                        <div class="ps-home-step">

                            <span class="ps-home-step-number">
                                01
                            </span>

                            <h3>Recherchez</h3>

                            <p>
                                Une ville, des dates et une place
                                qui correspond à vos besoins.
                            </p>

                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <div class="ps-home-step">

                            <span class="ps-home-step-number">
                                02
                            </span>

                            <h3>Réservez</h3>

                            <p>
                                Choisissez votre période et
                                confirmez votre réservation.
                            </p>

                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <div class="ps-home-step">

                            <span class="ps-home-step-number">
                                03
                            </span>

                            <h3>Stationnez</h3>

                            <p>
                                Profitez de votre place et
                                de tout ce qui vous attend.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

{% endblock %}