
{% extends "_modele.jinja" %}

{% block title %}
Paramètres du compte | ParkShare
{% endblock %}

{% block body_class %}ps-profile-edit-page{% endblock %}

{% block page_layout %}

<div class="ps-profile-edit">

    <div class="container-fluid ps-site-shell">

        <header class="ps-profile-edit-header">

            <span class="ps-profile-edit-eyebrow">
                MON COMPTE
            </span>

            <h1>Paramètres du compte</h1>

            <p>
                Gérez vos informations personnelles
                et la sécurité de votre compte.
            </p>

        </header>

        <div class="ps-profile-edit-layout">

{% with active_page = 'parametres' %}
    {% include "components/_account_sidebar.jinja" %}
{% endwith %}

            <div class="ps-profile-edit-content">
                <section class="ps-profile-edit-card"
                         aria-labelledby="personal-title">

                    <div class="ps-profile-edit-card-header">

                        <div>
                            <span class="ps-profile-edit-section-label">
                                PROFIL
                            </span>

                            <h2 id="personal-title">
                                Informations personnelles
                            </h2>

                            <p>
                                Mettez à jour les renseignements
                                associés à votre compte.
                            </p>
                        </div>

                        <div class="ps-profile-edit-header-icon">
                            <i class="bi bi-person"
                               aria-hidden="true"></i>
                        </div>

                    </div>

                    {% if error %}
                    <div class="alert alert-danger" role="alert">
                        {{ error }}
                    </div>
                    {% endif %}

                    {% if success %}
                    <div class="alert alert-success" role="status">
                        {{ success }}
                    </div>
                    {% endif %}

                    <form method="POST"
                          action="{{ url_for('profile.edit') }}"
                          novalidate
                          data-ajax-form="profile">

                        <input type="hidden"
                               name="_csrf"
                               value="{{ csrf_token() }}">

                        {% if errors is defined and errors %}
                        <div class="alert alert-danger"
                             role="alert"
                             data-server-errors>

                            {% for field, message in errors.items() %}
                            <p class="mb-1">{{ message }}</p>
                            {% endfor %}

                        </div>
                        {% endif %}

                        <div class="row g-4">

                            <div class="col-12 col-md-6">

                                <label for="prenom"
                                       class="form-label">
                                    Prénom
                                </label>

                                <input type="text"
                                       class="form-control"
                                       id="prenom"
                                       name="prenom"
                                       value="{{ request.form.get('prenom', g.user.prenom) }}"
                                       maxlength="80"
                                       autocomplete="given-name"
                                       required>

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="nom"
                                       class="form-label">
                                    Nom
                                </label>

                                <input type="text"
                                       class="form-control"
                                       id="nom"
                                       name="nom"
                                       value="{{ request.form.get('nom', g.user.nom) }}"
                                       maxlength="80"
                                       autocomplete="family-name"
                                       required>

                            </div>

                            <div class="col-12">

                                <label for="email"
                                       class="form-label">
                                    Adresse courriel
                                </label>

                                <input type="email"
                                       class="form-control"
                                       id="email"
                                       name="email"
                                       value="{{ request.form.get('email', g.user.email) }}"
                                       maxlength="254"
                                       autocomplete="email"
                                       required>

                            </div>

                        </div>

                        <div class="ps-profile-edit-actions">

                            <button type="submit"
                                    class="btn ps-profile-edit-btn-primary">

                                <i class="bi bi-check-lg me-2"
                                   aria-hidden="true"></i>

                                Enregistrer les modifications

                            </button>

                        </div>

                    </form>

                </section>


                <section class="ps-profile-edit-card"
                         aria-labelledby="password-title">

                    <div class="ps-profile-edit-card-header">

                        <div>
                            <span class="ps-profile-edit-section-label">
                                SÉCURITÉ
                            </span>

                            <h2 id="password-title">
                                Mot de passe
                            </h2>

                            <p>
                                Modifiez votre mot de passe
                                pour sécuriser votre compte.
                            </p>
                        </div>

                        <div class="ps-profile-edit-header-icon">
                            <i class="bi bi-shield-lock"
                               aria-hidden="true"></i>
                        </div>

                    </div>

                    {% if password_error %}
                    <div class="alert alert-danger" role="alert">
                        {{ password_error }}
                    </div>
                    {% endif %}

                    {% if password_success %}
                    <div class="alert alert-success" role="status">
                        {{ password_success }}
                    </div>
                    {% endif %}

                    <form method="POST"
                          action="{{ url_for('profile.change_password') }}"
                          novalidate
                          data-ajax-form="password">

                        <input type="hidden"
                               name="_csrf"
                               value="{{ csrf_token() }}">

                        <div class="mb-4">

                            <label for="current_password"
                                   class="form-label">
                                Mot de passe actuel
                            </label>

                            <input type="password"
                                   class="form-control"
                                   id="current_password"
                                   name="current_password"
                                   autocomplete="current-password"
                                   required>

                        </div>

                        <div class="row g-4">

                            <div class="col-12 col-md-6">

                                <label for="new_password"
                                       class="form-label">
                                    Nouveau mot de passe
                                </label>

                                <input type="password"
                                       class="form-control"
                                       id="new_password"
                                       name="new_password"
                                       minlength="8"
                                       maxlength="128"
                                       autocomplete="new-password"
                                       required>

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="confirm_password"
                                       class="form-label">
                                    Confirmer le mot de passe
                                </label>

                                <input type="password"
                                       class="form-control"
                                       id="confirm_password"
                                       name="confirm_password"
                                       minlength="8"
                                       maxlength="128"
                                       autocomplete="new-password"
                                       required>

                            </div>

                        </div>

                        <p class="ps-profile-edit-password-hint">
                            <i class="bi bi-info-circle me-1"
                               aria-hidden="true"></i>
                            Le mot de passe doit contenir
                            entre 8 et 128 caractères.
                        </p>

                        <div class="ps-profile-edit-actions">

                            <button type="submit"
                                    class="btn ps-profile-edit-btn-outline">

                                Modifier le mot de passe

                            </button>

                        </div>

                    </form>

                </section>

            </div>

        </div>

    </div>

</div>

{% endblock %}
