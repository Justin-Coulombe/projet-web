{% extends "_modele.jinja" %}

{% block title %}
Réservations reçues | ParkShare
{% endblock %}

{% block recherche %}{% endblock %}

{% block contenu %}

<div class="container my-5">

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-2">
                Réservations reçues
            </h1>

            <p class="text-muted mb-0">
                Consultez les réservations effectuées
                sur vos places de stationnement.
            </p>
        </div>

    </div>

    {% if reservations %}

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h2 class="h5 fw-bold mb-3">
                <i class="bi bi-calendar-check me-2"></i>
                Mes réservations reçues
                ({{ reservations|length }})
            </h2>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th scope="col">Réservation</th>
                            <th scope="col">Stationnement</th>
                            <th scope="col">Ville</th>
                            <th scope="col">Début</th>
                            <th scope="col">Fin</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for reservation in reservations %}

                        <tr>

                            <td>
                                #{{ reservation.id }}
                            </td>

                            <td>
                                <a href="{{ url_for(
                                    'stationnement.detail',
                                    publication_id=reservation.publication_id
                                ) }}"
                                   class="text-dark text-decoration-none fw-semibold">

                                    {{ reservation.address }}

                                </a>
                            </td>

                            <td>
                                {{ reservation.ville }}
                            </td>

                            <td class="text-nowrap">
                                <i class="bi bi-calendar-event me-1"></i>
                                {{ reservation.debut|replace('T', ' ') }}
                            </td>

                            <td class="text-nowrap">
                                <i class="bi bi-calendar-check me-1"></i>
                                {{ reservation.fin|replace('T', ' ') }}
                            </td>

                        </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    {% else %}

    <div class="card border-0 shadow-sm">

        <div class="card-body text-center py-5">

            <i class="bi bi-calendar-x text-secondary"
               style="font-size: 3rem;"></i>

            <h2 class="h5 fw-bold mt-3">
                Aucune réservation reçue
            </h2>

            <p class="text-muted">
                Vos stationnements n'ont reçu
                aucune réservation pour le moment.
            </p>

            <a href="{{ url_for('stationnement.ajouter_stationnement') }}"
               class="btn btn-dark mt-2">

                <i class="bi bi-plus-circle me-2"></i>
                Ajouter un stationnement

            </a>

        </div>

    </div>

    {% endif %}

</div>

{% endblock %}