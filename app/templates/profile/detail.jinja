
{% extends "_modele.jinja" %}

{% block title %}
Mon profil | ParkShare
{% endblock %}

{% block body_class %}ps-profile-page{% endblock %}

{% block page_layout %}

<div class="ps-profile-edit ps-account-page">

    <div class="container-fluid ps-site-shell">

        <header class="ps-profile-edit-header">

            <span class="ps-profile-edit-eyebrow">
                MON COMPTE
            </span>

            <h1>Mon profil</h1>

            <p>
                Retrouvez vos informations,
                vos annonces et votre activité sur ParkShare.
            </p>

        </header>

        <div class="ps-profile-edit-layout">

            {% with active_page = 'profil' %}
                {% include "components/_account_sidebar.jinja" %}
            {% endwith %}

            <div class="ps-profile-edit-content">

                {% if success %}
                <div class="alert alert-success" role="status">
                    {{ success }}
                </div>
                {% endif %}

            <div class="row g-2 mt-2 text-center">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <p class="card-subtitle fg-3 fw-bold">{{ lst_pubications|length }}</p>
                            <p class="card-subtitle fg-3 opacity-75">Annonce(s)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <p class="card-subtitle fg-3 fw-bold">{{ lst_reversations|length }}</p>
                            <p class="card-subtitle fg-3 opacity-75">Réservation(s)</p>
                        </div>
                    </div>
                </div>
                <a class="text-decoration-none" href="#">
                    <div class="card border-0 shadow-sm mb-4 col-md-12">
                        <div class="card-body">
                            <p class="card-subtitle fg-3 fw-bold">{{ lst_reversations|length }}</p>
                            <p class="card-subtitle fg-3 opacity-75">Réservation(s) Reçue(s)</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
                <section class="ps-profile-edit-card">

                    <div class="ps-profile-edit-card-header">

                    {% if success %}
                    <div class="alert alert-success">{{ success }}</div>
                    {% endif %}

                    {% if not lst_pubications %}
                    <p>Vous n'avez aucune annonce pour le moment.</p>
                    <a class="btn btn-sm btn-outline-dark" href="{{ url_for('stationnement.ajouter_stationnement') }}">
                        <i class="bi bi-plus-circle"></i>
                        Ajouter un stationnement
                    </a>
                    {% else %}
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Adresse</th>
                                    <th>Ville</th>
                                    <th>Prix</th>
                                    <th>Nombre de places</th>
                                    <th>Emplacement</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for publication in lst_pubications %}
                                <tr>
                                    <td>
                                        <a class="text-decoration-none text-dark"
                                            href="{{ url_for('stationnement.detail', publication_id=publication.id) }}">
                                            {{ publication.address }}
                                        </a>
                                    </td>
                                    <td>{{ publication.city }}</td>
                                    <td class="text-nowrap">{{ publication.price }} $/heure</td>
                                    <td>{{ publication.place_total }}</td>
                                    <td>
                                        <span class="badge bg-dark">{{ publication.location }}</span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="{{ url_for('stationnement.edit', publication_id=publication.id) }}"
                                                class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square"></i>
                                                Modifier
                                            </a>
                                            <form method="POST" data-ajax-form="delete"
                                                data-confirm="Supprimer définitivement cette annonce ?"
                                                action="{{ url_for('stationnement.delete', publication_id=publication.id) }}">
                                                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-trash"></i>
                                                    Supprimer
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Mes réservations effectuées -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4>Mes réservations</h4>

                    {% if not lst_reversations %}
                    <p>Vous n'avez aucune réservation pour le moment...</p>
                    {% else %}
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">Adresse</th>
                                    <th scope="col">Ville</th>
                                    <th scope="col">Début</th>
                                    <th scope="col">Fin</th>
                                    <th scope="col">Actions</th>

                                </tr>
                            </thead>
                            <tbody>
                                {% for reservation in lst_reversations %}
                                <tr>
                                    <td>{{ reservation.post.address }}</td>
                                    <td>{{ reservation.post.city }}</td>
                                    <td class="text-nowrap">
                                        <i class="bi bi-calendar-event me-1"></i>{{ reservation.start|replace('T', ' ')
                                        }}
                                    </td>
                                    <td class="text-nowrap">
                                        <i class="bi bi-calendar-check me-1"></i>{{ reservation.end|replace('T', ' ') }}
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="{{ url_for('detail.edit', reservation_id=reservation.id) }}" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square"></i>
                                                Modifier
                                            </a>
                                            <form method="POST" data-ajax-form="delete"
                                                data-confirm="Supprimer définitivement cette réservation ?"
                                                action="{{ url_for('detail.delete', reservation_id=reservation.id) }}">
                                                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-trash"></i>
                                                    Supprimer
                                                </button>
                        <div>
                            <span class="ps-profile-edit-section-label">
                                VOTRE PROFIL
                            </span>

                            <h2>Informations personnelles</h2>

                            <p>
                                Les informations associées
                                à votre compte ParkShare.
                            </p>
                        </div>

                        <div class="ps-profile-edit-header-icon">
                            <i class="bi bi-person"
                               aria-hidden="true"></i>
                        </div>

                    </div>

                    <div class="ps-account-profile-info">

                        <div>
                            <span>Prénom</span>
                            <strong>{{ g.user.prenom }}</strong>
                        </div>

                        <div>
                            <span>Nom</span>
                            <strong>{{ g.user.nom }}</strong>
                        </div>

                        <div class="ps-account-info-full">
                            <span>Adresse courriel</span>
                            <strong>{{ g.user.email }}</strong>
                        </div>

                    </div>

                    <div class="ps-profile-edit-actions">

                        <a href="{{ url_for('profile.edit') }}"
                           class="btn ps-profile-edit-btn-outline">

                            <i class="bi bi-pencil-square me-2"
                               aria-hidden="true"></i>

                            Modifier mes informations
                        </a>

                    </div>

                </section>

                <section class="ps-profile-edit-card">

                    <div class="ps-account-section-heading">

                        <div>
                            <span class="ps-profile-edit-section-label">
                                STATIONNEMENTS
                            </span>

                            <h2>Mes annonces</h2>

                            <p>
                                Gérez les places de stationnement
                                que vous proposez.
                            </p>
                        </div>

                        <a href="{{ url_for('stationnement.ajouter_stationnement') }}"
                           class="btn ps-profile-edit-btn-primary">

                            <i class="bi bi-plus-lg me-1"
                               aria-hidden="true"></i>

                            Ajouter
                        </a>

                    </div>


                    {% if lst_pubications %}

                    <div class="table-responsive">

                        <table class="table ps-account-table align-middle">

                            <thead>
                                <tr>
                                    <th scope="col">Stationnement</th>
                                    <th scope="col">Prix</th>
                                    <th scope="col">Places</th>
                                    <th scope="col">Emplacement</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                {% for publication in lst_pubications %}

                                <tr>

                                    <td>
                                        <a href="{{ url_for('stationnement.detail', publication_id=publication.id) }}"
                                           class="ps-account-table-link">

                                            <strong>
                                                {{ publication.address }}
                                            </strong>

                                            <span>
                                                {{ publication.city }}
                                            </span>

                                        </a>
                                    </td>

                                    <td class="text-nowrap">
                                        <strong>
                                            {{ "%.2f" | format(publication.price | float) | replace(".", ",") }} $
                                        </strong>

                                        <span class="ps-account-muted">
                                            /h
                                        </span>
                                    </td>

                                    <td>
                                        {{ publication.placeTotal }}
                                    </td>

                                    <td>
                                        <span class="ps-account-tag">
                                            {{ publication.location }}
                                        </span>
                                    </td>

                                    <td>
                                        <div class="ps-account-table-actions">

                                            <a href="{{ url_for('stationnement.edit', publication_id=publication.id) }}"
                                               class="btn ps-account-action-button"
                                               aria-label="Modifier l'annonce {{ publication.address }}">

                                                <i class="bi bi-pencil-square"
                                                   aria-hidden="true"></i>
                                            </a>

                                            <form method="POST"
                                                  action="{{ url_for('stationnement.delete', publication_id=publication.id) }}"
                                                  data-ajax-form="delete"
                                                  data-confirm="Supprimer définitivement cette annonce ?">

                                                <input type="hidden"
                                                       name="_csrf"
                                                       value="{{ csrf_token() }}">

                                                <button type="submit"
                                                        class="btn ps-account-action-button ps-account-action-danger"
                                                        aria-label="Supprimer l'annonce {{ publication.address }}">

                                                    <i class="bi bi-trash"
                                                       aria-hidden="true"></i>

                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Mes réservations reçues -->
            {% set reservations_recues = reservations|default([]) %}
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4 class="h5 fw-bold mb-3">
                        <i class="bi bi-calendar-check me-2"></i>
                        Mes réservations reçues ({{ reservations_recues|length }})
                    </h4>

                    {% if reservations_recues %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Réservée par</th>
                                    <th scope="col">Stationnement</th>
                                    <th scope="col">Ville</th>
                                    <th scope="col">Début</th>
                                    <th scope="col">Fin</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reservation in reservations_recues %}
                                <tr>
                                    <td>#{{ reservation.id }}</td>
                                    {# <td><a href="{{}}"> #}
                                        </a>
                                    </td>
                                    <td>
                                        <a href="{{ url_for('stationnement.detail', publication_id=reservation.publication_id) }}"
                                            class="text-dark text-decoration-none fw-semibold">
                                            {{ reservation.address }}
                                        </a>
                                    </td>
                                    <td>{{ reservation.ville }}</td>
                                    <td class="text-nowrap">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        {{ reservation.debut|replace('T', ' ') }}
                                    </td>
                                    <td class="text-nowrap">
                                        <i class="bi bi-calendar-check me-1"></i>
                                        {{ reservation.fin|replace('T', ' ') }}
                                    </td>

                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x text-secondary" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold mt-3">Aucune réservation reçue</h5>
                        <p class="text-muted">
                            Vos stationnements n'ont reçu aucune réservation pour le moment.
                        </p>
                        <a href="{{ url_for('stationnement.ajouter_stationnement') }}" class="btn btn-dark mt-2">
                            <i class="bi bi-plus-circle me-2"></i>
                            Ajouter un stationnement
                        </a>
                    </div>

                                </tr>

                                {% endfor %}

                            </tbody>

                        </table>

                    </div>

                    {% else %}

                    <div class="ps-account-empty">

                        <i class="bi bi-p-square"
                           aria-hidden="true"></i>

                        <h3>Aucune annonce pour le moment</h3>

                        <p>
                            Vous n'avez pas encore publié
                            de stationnement sur ParkShare.
                        </p>

                        <a href="{{ url_for('stationnement.ajouter_stationnement') }}"
                           class="btn ps-profile-edit-btn-primary">

                            Proposer une place
                        </a>

                    </div>

                    {% endif %}

                </section>

                <section class="ps-account-reservations-banner">

                    <div>
                        <span class="ps-profile-edit-section-label">
                            ACTIVITÉ
                        </span>

                        <h2>Vos réservations au même endroit.</h2>

                        <p>
                            Consultez vos réservations effectuées
                            et celles reçues sur vos stationnements.
                        </p>
                    </div>

                    <a href="{{ url_for('detail.mes_reservations') }}"
                       class="btn ps-account-banner-button">

                        Voir mes réservations

                        <i class="bi bi-arrow-up-right ms-1"
                           aria-hidden="true"></i>

                    </a>

                </section>

            </div>

        </div>

    </div>

</div>
{% endblock %}

{% endblock %}
