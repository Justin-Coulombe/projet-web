{% extends "_modele.jinja" %}

{% block title %}
Mon profil | ParkShare
{% endblock %}

{% block recherche%}
{% endblock %}


{% block contenu %}
<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-md-3">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body p-1">
                    <div class="card-body">
                        <i class="d-flex justify-content-center bi bi-person-circle " style="font-size: 100px;"></i>
                        <h4 class="card-title d-flex justify-content-center">{{g.user.nom}} {{g.user.prenom}}</h4>
                        <p class="card-subtitle fg-3 fw-bold">Nom</p>
                        <p class="card-subtitle fg-3 opacity-75">{{g.user.nom}}</p>
                        <p class="card-subtitle fg-3 fw-bold">Prenom</p>
                        <p class="card-subtitle fg-3 opacity-75">{{g.user.prenom}}</p>
                        <p class="card-subtitle fg-3 fw-bold">Courriel</p>
                        <p class="card-subtitle fg-3 opacity-75">{{g.user.email}}</p>
                        <div class="d-grid gap-2 mt-2">
                            <a href="/profile" class=" bi bi-pencil-square btn btn-outline-dark"> Modifier mon
                                profil</a>
                        </div>
                    </div>
                </div>

            </div>
            <div class="row g-2 mt-2 text-center">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <p class="card-subtitle fg-3 fw-bold">{{lst_pubications|length}}</p>
                            <p class="card-subtitle fg-3 opacity-75">Annonce(s)</p>

                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <p class="card-subtitle fg-3 fw-bold">{{lst_reversations|length}}</p>
                            <p class="card-subtitle fg-3 opacity-75">Réservation(s)</p>
                        </div>
                    </div>
                </div>

            </div>

        </div>


        <div class="col-md-9">
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">

        <h4>Mes annonces</h4>

        {% if success %}
        <div class="alert alert-success">
            {{ success }}
        </div>
        {% endif %}

        {% if not lst_pubications %}

        <p>Vous n'avez aucune annonce pour le moment.</p>

        <a class="btn btn-sm btn-outline-dark"
           href="{{ url_for('stationnement.ajouter_stationnement') }}">
            <i class="bi bi-plus-circle"></i>
            Ajouter un stationnement
        </a>

        {% else %}

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Adresse</th>
                        <th>Ville</th>
                        <th>Prix</th>
                        <th>Nombre de places</th>
                        <th>Emplacement</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    {% for publication in lst_pubications %}

                    <tr>
                        <td>
                            <a class="text-decoration-none text-dark"
                               href="{{ url_for(
                                   'stationnement.detail',
                                   publication_id=publication.id
                               ) }}">
                                {{ publication.address }}
                            </a>
                        </td>

                        <td>{{ publication.city }}</td>

                        <td class="text-nowrap">
                            {{ publication.price }} $/heure
                        </td>

                        <td>{{ publication.placeTotal }}</td>

                        <td>
                            <span class="badge bg-dark">
                                {{ publication.location }}
                            </span>
                        </td>

                        <td>
                            <div class="d-flex gap-2">

                                <a href="{{ url_for(
                                    'stationnement.edit',
                                    publication_id=publication.id
                                ) }}"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil-square"></i>
                                    Modifier
                                </a>

                                <form method="POST"
                                      data-ajax-form="delete"
                                      data-confirm="Supprimer définitivement cette annonce ?"
                                      action="{{ url_for(
                                          'stationnement.delete',
                                          publication_id=publication.id
                                      ) }}">

                                    <input type="hidden"
                                           name="_csrf"
                                           value="{{ csrf_token() }}">

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                        Supprimer
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

        {% endif %}

    </div>
</div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4>Mes réservations</h4>
                    {% if not lst_reversations %}
                    <p>Vous avez aucune réservation pour le moment...</p>
                    <a class="btn btn-sm bi bi-plus-circle" href="#"> réservé une place de stationnement</a>
                    {% else %}
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Adresse</th>
                                <th scope="col">Ville</th>
                                <th scope="col">date de début</th>
                                <th scope="col">Date de fin</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in lst_reversations %}
                            <tr>
                                <td>{{ reservation.post.address }}</td>
                                <td>{{ reservation.post.city }}</td>
                                <td>{{ reservation.start }}</td>
                                <td> {{ reservation.end }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}