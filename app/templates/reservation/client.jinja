{% extends "_modele.jinja" %}

{% block title %}
{{ client.prenom }} {{ client.nom }} | ParkShare
{% endblock %}

{% block recherche %}{% endblock %}

{% block contenu %}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0">Fiche du client</h1>
        <a href="{{ url_for('detail.detail_profil') }}" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-1"></i>
            Retour
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-5">

            <div class="row g-4 align-items-center">

                <div class="col-md-4 text-center">
                    <i class="bi bi-person-circle"
                       style="font-size: 160px; line-height: 1;"></i>
                </div>

                <div class="col-md-8">

                    <h2 class="fw-bold mb-4">
                        {{ client.prenom }} {{ client.nom }}
                    </h2>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Prénom</p>
                            <p class="fs-5 mb-0">{{ client.prenom }}</p>
                        </div>

                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Nom</p>
                            <p class="fs-5 mb-0">{{ client.nom }}</p>
                        </div>

                        <div class="col-12">
                            <p class="text-muted small mb-1">Courriel</p>
                            <p class="fs-5 mb-0">{{ client.email }}</p>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

{% endblock %}