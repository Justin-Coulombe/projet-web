
{% extends "_modele.jinja" %}

{% block title %}
Modifier un stationnement | ParkShare
{% endblock %}

{% block body_class %}ps-parking-edit-page{% endblock %}

{% block extra_head %}
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
{% endblock %}

{% block page_layout %}

{% set ville_actuelle = ville if ville is defined else publication.city %}
{% set emplacement_actuel = emplacement if emplacement is defined else publication.location %}

<div class="ps-parking-create ps-parking-edit">

    <div class="container-fluid ps-site-shell">

        <header class="ps-parking-create-header">

            <a href="{{ url_for('detail.detail_profil') }}"
               class="ps-parking-edit-back">

                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Retour à mes annonces
            </a>

            <span class="ps-parking-create-eyebrow">
                GESTION DES STATIONNEMENTS
            </span>

            <h1>Modifier votre annonce</h1>

            <p>
                Mettez à jour les informations de votre
                stationnement et gérez sa photo.
            </p>

        </header>

        {% if success %}
        <div class="alert alert-success ps-parking-edit-alert"
             role="status">
            <i class="bi bi-check-circle me-2"
               aria-hidden="true"></i>
            {{ success }}
        </div>
        {% endif %}

        {% if img_success %}
        <div class="alert alert-success ps-parking-edit-alert"
             role="status">
            <i class="bi bi-check-circle me-2"
               aria-hidden="true"></i>
            {{ img_success }}
        </div>
        {% endif %}

        <div class="ps-parking-create-layout">

            <div class="ps-parking-create-main">

                <form id="ajout_form"
                      action="{{ url_for('stationnement.edit', publication_id=publication.id) }}"
                      method="POST"
                      data-ajax-form="parking-edit"
                      data-original-adresse="{{ publication.address | e }}"
                      data-original-ville="{{ publication.city | e }}"
                      data-has-coordinates="{{ 'true' if has_coordinates | default(false) else 'false' }}"
                      novalidate>

                    <input type="hidden"
                           name="_csrf"
                           value="{{ csrf_token() }}">

                    <input type="hidden"
                           id="geocode-token"
                           name="geocode_token">

                    {% if errors %}
                    <div class="alert alert-danger mb-4"
                         role="alert"
                         data-server-errors>

                        {% for field, message in errors.items() %}
                        <p class="mb-1">{{ message }}</p>
                        {% endfor %}

                    </div>
                    {% endif %}

                    <section class="ps-parking-create-card mb-4">

                        <div class="ps-parking-create-card-heading">

                            <div class="ps-parking-create-card-icon">
                                <i class="bi bi-geo-alt"
                                   aria-hidden="true"></i>
                            </div>

                            <div>
                                <span class="ps-parking-create-section-label">
                                    LOCALISATION
                                </span>

                                <h2>Adresse du stationnement</h2>

                                <p>
                                    Modifiez l'emplacement de votre
                                    stationnement si nécessaire.
                                </p>
                            </div>

                        </div>

                        <div class="row g-4">

                            <div class="col-12">

                                <label for="adresse"
                                       class="form-label">
                                    Adresse
                                </label>

                                <input type="text"
                                       id="adresse"
                                       name="adresse"
                                       class="form-control {{ classe_adresse | default('') }}"
                                       value="{{ adresse if adresse is defined else publication.address }}"
                                       placeholder="Ex. 133 boulevard de l'Entente"
                                       autocomplete="street-address"
                                       maxlength="200"
                                       required>

                                <div class="invalid-feedback">
                                    {{ msg_adresse | default('') }}
                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="ville"
                                       class="form-label">
                                    Ville
                                </label>

                                <select id="ville"
                                        name="ville"
                                        class="form-select {{ classe_ville | default('') }}"
                                        required>

                                    <option value="">
                                        Choisissez une ville
                                    </option>

                                    {% for nom_ville in [
                                        "Montréal",
                                        "Québec",
                                        "Laval",
                                        "Gatineau",
                                        "Longueuil",
                                        "Sherbrooke",
                                        "Lévis",
                                        "Saguenay",
                                        "Trois-Rivières",
                                        "Terrebonne",
                                        "Saint-Jean-sur-Richelieu",
                                        "Brossard",
                                        "Repentigny",
                                        "Saint-Jérôme",
                                        "Drummondville"
                                    ] %}

                                    <option value="{{ nom_ville }}"
                                        {% if ville_actuelle == nom_ville %}
                                            selected
                                        {% endif %}>
                                        {{ nom_ville }}
                                    </option>

                                    {% endfor %}

                                </select>

                                <div class="invalid-feedback">
                                    {{ msg_ville | default('') }}
                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="province"
                                       class="form-label">
                                    Province
                                </label>

                                <input type="text"
                                       id="province"
                                       class="form-control"
                                       value="Québec"
                                       disabled>

                            </div>

                        </div>

                        <div class="ps-parking-create-geocode">

                            <div class="ps-parking-create-geocode-heading">

                                <h3>Vérification de l'adresse</h3>

                                <p>
                                    Si vous changez l'adresse ou la ville,
                                    vérifiez la nouvelle localisation
                                    avant d'enregistrer.
                                </p>

                            </div>

                            <button type="button"
                                    id="verifier-adresse"
                                    class="btn ps-parking-create-btn-outline">

                                <i class="bi bi-geo-alt me-2"
                                   aria-hidden="true"></i>

                                Vérifier l'adresse

                            </button>

                            <p id="geocode-status"
                               class="small mt-2 mb-0"
                               role="status"
                               aria-live="polite"></p>

                            {% if msg_position %}
                            <p class="text-danger small mt-2">
                                {{ msg_position }}
                            </p>
                            {% endif %}

                            <div id="geocode-preview"
                                 class="ps-parking-create-geocode-preview"
                                 hidden>

                                <div class="ps-parking-create-success">

                                    <i class="bi bi-check-circle-fill"
                                       aria-hidden="true"></i>

                                    <div>
                                        <strong>Adresse trouvée !</strong>

                                        <p id="adresse-reconnue"
                                           class="mb-1"></p>

                                        <small>
                                            Vérifiez que le repère
                                            correspond à votre stationnement.
                                        </small>
                                    </div>

                                </div>

                                <div id="geocode-map"
                                     aria-label="Carte de vérification de l'adresse">
                                </div>

                            </div>

                        </div>

                    </section>

                    <section class="ps-parking-create-card mb-4">

                        <div class="ps-parking-create-card-heading">

                            <div class="ps-parking-create-card-icon">
                                <i class="bi bi-p-square"
                                   aria-hidden="true"></i>
                            </div>

                            <div>
                                <span class="ps-parking-create-section-label">
                                    CARACTÉRISTIQUES
                                </span>

                                <h2>Informations du stationnement</h2>

                                <p>
                                    Modifiez le tarif, le nombre de places
                                    et le type de stationnement.
                                </p>
                            </div>

                        </div>

                        <div class="row g-4">

                            <div class="col-12 col-md-6">

                                <label for="prix"
                                       class="form-label">
                                    Prix par heure
                                </label>

                                <div class="input-group ps-parking-create-input-group">

                                    <input type="number"
                                           id="prix"
                                           name="prix"
                                           class="form-control {{ classe_prix | default('') }}"
                                           value="{{ prix if prix is defined else publication.price }}"
                                           min="0.01"
                                           max="1000"
                                           step="0.01"
                                           required>

                                    <span class="input-group-text">
                                        $ / heure
                                    </span>

                                </div>

                                <div class="invalid-feedback">
                                    {{ msg_prix | default('') }}
                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <label for="place"
                                       class="form-label">
                                    Nombre de places
                                </label>

                                <input type="number"
                                       id="place"
                                       name="place"
                                       class="form-control {{ classe_place | default('') }}"
                                    value="{{ place if place is defined else publication.place_total }}"
                                       min="1"
                                       max="100"
                                       step="1"
                                       required>

                                <div class="invalid-feedback">
                                    {{ msg_place | default('') }}
                                </div>

                            </div>

                            <div class="col-12">

                                <label for="emplacement"
                                       class="form-label">
                                    Type de stationnement
                                </label>

                                <select id="emplacement"
                                        name="emplacement"
                                        class="form-select {{ classe_emplacement | default('') }}"
                                        required>

                                    <option value="">
                                        Sélectionnez un type
                                    </option>

                                    <option value="Intérieur"
                                        {% if emplacement_actuel == 'Intérieur' %}
                                            selected
                                        {% endif %}>
                                        Intérieur
                                    </option>

                                    <option value="Extérieur"
                                        {% if emplacement_actuel == 'Extérieur' %}
                                            selected
                                        {% endif %}>
                                        Extérieur
                                    </option>

                                </select>

                                <div class="invalid-feedback">
                                    {{ msg_emplacement | default('') }}
                                </div>

                            </div>

                        </div>

                    </section>

                    <div class="ps-parking-create-actions">

                        <a href="{{ url_for('detail.detail_profil') }}"
                           class="btn ps-parking-create-btn-outline">

                            Annuler
                        </a>

                        <button type="submit"
                                class="btn ps-parking-create-btn-primary">

                            <i class="bi bi-check-lg me-2"
                               aria-hidden="true"></i>

                            Enregistrer les modifications

                        </button>

                    </div>

                </form>

                <section class="ps-parking-create-card">

                    <div class="ps-parking-create-card-heading">

                        <div class="ps-parking-create-card-icon">
                            <i class="bi bi-image"
                               aria-hidden="true"></i>
                        </div>

                        <div>
                            <span class="ps-parking-create-section-label">
                                PHOTO
                            </span>

                            <h2>Image du stationnement</h2>

                            <p>
                                Remplacez la photo actuelle
                                par une nouvelle image.
                            </p>
                        </div>

                    </div>

                    {% if error %}
                    <div class="alert alert-danger" role="alert">
                        {{ error }}
                    </div>
                    {% endif %}

                    <div class="ps-parking-edit-current-image">

                        {% if publication.img %}
                        <img
                            src="{{ url_for('static', filename='img/stationnement/' ~ publication.img) }}"
                            alt="Photo actuelle du stationnement"
                            loading="lazy">
                        {% else %}
                        <img
                            src="{{ url_for('static', filename='img/placeholder.jpg') }}"
                            alt="Photo non disponible"
                            loading="lazy">
                        {% endif %}

                        <div class="ps-parking-edit-image-caption">
                            Photo actuelle du stationnement
                        </div>

                    </div>

                    <form method="POST"
                          action="{{ url_for('stationnement.change_img', publication_id=publication.id) }}"
                          enctype="multipart/form-data"
                          data-ajax-form="image"
                          novalidate>

                        <input type="hidden"
                               name="_csrf"
                               value="{{ csrf_token() }}">

                        <div class="ps-parking-create-upload">

                            <div class="ps-parking-create-upload-icon">
                                <i class="bi bi-cloud-arrow-up"
                                   aria-hidden="true"></i>
                            </div>

                            <label for="image"
                                   class="form-label">
                                Nouvelle photo
                            </label>

                            <p>
                                Choisissez une nouvelle image
                                pour votre annonce.
                            </p>

                            <input type="file"
                                   id="image"
                                   name="image"
                                   class="form-control"
                                   accept="image/jpeg,image/png,image/webp"
                                   required>

                            <small>
                                Formats : JPEG, PNG ou WebP.
                                Maximum 2 Mo.
                            </small>

                        </div>

                        <div class="ps-parking-edit-image-actions">

                            <button type="submit"
                                    class="btn ps-parking-create-btn-primary">

                                <i class="bi bi-arrow-repeat me-2"
                                   aria-hidden="true"></i>

                                Remplacer la photo

                            </button>

                        </div>

                    </form>

                </section>

            </div>

            <aside class="ps-parking-create-sidebar">

                <div class="ps-parking-create-help">

                    <div class="ps-parking-create-help-icon">
                        <i class="bi bi-lightbulb"
                           aria-hidden="true"></i>
                    </div>

                    <h2>Modifier votre annonce</h2>

                    <p>
                        Gardez les informations de votre
                        stationnement à jour.
                    </p>

                    <ul>

                        <li>
                            <i class="bi bi-check-circle"
                               aria-hidden="true"></i>

                            Vérifiez l'adresse si vous la modifiez.
                        </li>

                        <li>
                            <i class="bi bi-check-circle"
                               aria-hidden="true"></i>

                            Indiquez le nombre réel de places.
                        </li>

                        <li>
                            <i class="bi bi-check-circle"
                               aria-hidden="true"></i>

                            Utilisez une photo récente.
                        </li>

                    </ul>

                </div>

                <div class="ps-parking-create-note">

                    <i class="bi bi-info-circle"
                       aria-hidden="true"></i>

                    <p>
                        Les modifications du stationnement
                        et le remplacement de la photo
                        s'enregistrent séparément.
                    </p>

                </div>

                <a href="{{ url_for('stationnement.detail', publication_id=publication.id) }}"
                   class="btn ps-parking-create-btn-outline ps-parking-edit-view">

                    <i class="bi bi-eye me-2"
                       aria-hidden="true"></i>

                    Voir l'annonce

                </a>

            </aside>

        </div>

    </div>

</div>

{% endblock %}

{% block script %}
<script src="{{ url_for('static', filename='js/base.js') }}"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="{{ url_for('static', filename='js/geocoding.js') }}"></script>
{% endblock %}
