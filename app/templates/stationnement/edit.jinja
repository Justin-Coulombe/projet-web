{% extends "_modele.jinja" %}

{% block title %}
stationnement | ParkShare
{% endblock %}

{% block script %}
{#
<script defer src="/static/js/validation.js"></script> #}
{#
<script src="/static/js/base.js"></script> #}
{% endblock %}

{% block recherche%}
{% endblock %}

{% block contenu %}
<div class="d-flex flex-column align-items-center justify-content-center mt-3">
    <h2>Modifier un stationnement</h2>
    <p>Modifier votre place de stationnement en toute sécurité</p>
</div>
{% set path = "/static/img/stationnement/" %}


<form id="ajout_form" class="row g-3" action="/stationnement/edit/{{publication_id}}" enctype="multipart/form-data"
    method="post" novalidate>
    <img class="col-md-6 img-fluid rounded-3"
        src="{% if publication.img %} {{path~publication.img}} {%else%} {{url_for('static', filename='img/placeholder.jpg')}} {%endif%}"
        alt="photo de la place">

    <div class="col-md-6">
        <div class="row">
            <div class="col-md-6">
                <label for="adresse" class="form-label">Adresse stationnement</label>
                <input type="text" name="adresse" class="form-control {{classe_adresse}}" id="adresse"
                    placeholder="133 boulevard de l'entente" value=" {{ publication.address }}">
                <div class="invalid-feedback">{{msg_adresse}}</div>
            </div>

            <div class="col-md-6">
                <div class="input-group">
                    <label for="prix" class="form-label input-group">Prix</label>
                    <input type="number" class="form-control {{classe_prix}}" id="prix" name="prix"
                        value="{{publication.price}}">
                    <span class="input-group-text">$/heure</span>
                    <div class="invalid-feedback">{{msg_prix}}</div>

                </div>
            </div>
            <div class="col-md-6 mt-3">
                <label for="ville" class="form-label">Ville</label>
                <select id="ville" name="ville" class="form-select {{classe_ville}}">
                    <option selected value="">Choisissez la ville</option>
                    <option {% if publication.city=="Montréal" %}selected{% endif %}>Montréal</option>
                    <option {% if publication.city=="Québec" %}selected{% endif %}>Québec</option>
                    <option {% if publication.city=="Laval" %}selected{% endif %}>Laval</option>
                    <option {% if publication.city=="Gatineau" %}selected{% endif %}>Gatineau</option>
                    <option {% if publication.city=="Longueuil" %}selected{% endif %}>Longueuil</option>
                    <option {% if publication.city=="Sherbrooke" %}selected{% endif %}>Sherbrooke</option>
                    <option {% if publication.city=="Lévis" %}selected{% endif %}>Lévis</option>
                    <option {% if publication.city=="Saguenay" %}selected{% endif %}>Saguenay</option>
                    <option {% if publication.city=="Trois-Rivières" %}selected{% endif %}>Trois-Rivières</option>
                    <option {% if publication.city=="Terrebonne" %}selected{% endif %}>Terrebonne</option>
                    <option {% if publication.city=="Saint-Jean-sur-Richelieu" %}selected{% endif %}>
                        Saint-Jean-sur-Richelieu
                    </option>
                    <option {% if publication.city=="Brossard" %}selected{% endif %}>Brossard</option>
                    <option {% if publication.city=="Repentigny" %}selected{% endif %}>Repentigny</option>
                    <option {% if publication.city=="Saint-Jérôme" %}selected{% endif %}>Saint-Jérôme</option>
                    <option {% if publication.city=="Drummondville" %}selected{% endif %}>Drummondville</option>
                </select>
                <div class="invalid-feedback">{{msg_ville}}</div>
            </div>

            <div class="col-md-6 mt-3">
                <label for="place" class="form-label ">Nombre de place</label>
                <input type="number" class="form-control {{classe_place}}" id="place" name="place"
                    value="{{publication.open_place}}">
                <div class="invalid-feedback">{{msg_place}}</div>
            </div>

            <fieldset class="border mt-3">
                <legend class="float-none w-auto px-2">Les disponibilités du stationnement</legend>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="dateDebut" class="form-label">Disponible du :</label>
                        <input type="datetime-local" class="form-control {{classe_debut}}" id="dateDebut"
                            name="dateDebut" value="{{publication.start}}" required>
                        <div class="invalid-feedback">{{msg_debut}}</div>

                    </div>
                    <div class="col-md-6">
                        <label for="dateFin" class="form-label">Jusqu'au :</label>
                        <input type="datetime-local" class="form-control {{classe_fin}}" id="dateFin" name="dateFin"
                            value="{{publication.end}}" required>
                        <div class="invalid-feedback" id="msgFin">{{msg_fin}}</div>
                    </div>
                </div>
            </fieldset>

            <div class="col-md-6 mt-3">
                <label for="emplacement" class="form-label">Emplacement</label>
                <select id="emplacement" name="emplacement" class="form-select {{classe_emplacement}}">
                    <option selected>Sélectionnez</option>
                    <option value="Intérieur" {% if publication.location=="Intérieur" %}selected{% endif %}>Intérieur
                    </option>
                    <option value="Extérieur" {% if publication.location=="Extérieur" %}selected{% endif %}>Extérieur
                    </option>
                </select>
                <div class="invalid-feedback">{{msg_emplacement}}</div>
            </div>

            <div class="col-md-6 mt-3">
                <label for="province" class="form-label">Province</label>
                <input type="text" class="form-control" id="province" value="Québec" disabled>

            </div>
        </div>
    </div>
    <div class="col-md-12">
        <label for="image" class="form-label">Image du stationnement</label>
        <div class="input-group mb-3">
            <input type="file" class="form-control {{classe_image}}" id="image" name="image">
            <div class="invalid-feedback mb-3">{{message_image}}</div>
        </div>
    </div>


    <div class="d-grid gap-2 col-6 mx-auto mt-0">
    </div>
    <div class="d-grid gap-2  d-flex justify-content-end">
        <button type="submit" class="btn btn-danger col-md-2 ">Supprimer stationnement</button>
        <button type="submit" class="btn btn-dark col-md-2">Enregistrer les modifications</button>
    </div>
</form>
{% endblock %}