{% extends "_modele.jinja" %}

{% block title %}
stationnement | ParkShare
{% endblock %}

{% block script %}
<script defer src="/static/js/validation.js"></script>
<script src="/static/js/base.js"></script>
{% endblock %}

{% block recherche%}
{% endblock %}

{% block contenu %}
{% set path = "/static/img/stationnement/" %}

<div class="d-flex align-items-center justify-content-between mt-2">
    <h2 class="fs-4 fw-bold">Modifier l'annonce</h2>
    <a href="/profile/detail" class="link-underline link-underline-opacity-0 text-black">
        <p class="fs-6">Mon espaces →</p>
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <h2 class="h5 fw-bold mb-4">
            Information du stationnement
        </h2>

        {% if success %}
        <div class="alert alert-success">{{ success }}</div>
        {% endif %}

        <form id="ajout_form" class="row g-3" action="/stationnement/edit/{{ publication.id }}"
            enctype="multipart/form-data" method="post" novalidate>

            <div class="col-md-12">
                <label for="adresse" class="form-label fw-bold">Adresse stationnement</label>
                <input type="text" name="adresse" class="form-control {{classe_adresse}}" id="adresse"
                    placeholder="133 boulevard de l'entente" value=" {{ publication.address }}">
                <div class="invalid-feedback">{{msg_adresse}}</div>
            </div>
            <div class="col-md-6">
                <label for="ville" class="form-label fw-bold">Ville</label>
                <select id="ville" name="ville" class="form-select {{classe_ville}}">
                    <option selected value="">Choisissez la ville</option>
                    <option {% if publication.city=="Montréal" %}selected{% endif %}>Montréal</option>
                    <option {% if publication.city=="Québec" %}selected{% endif %}>Québec</option>
                    <option {% if publication.city=="Laval" %}selected{% endif %}>Laval</option>
                    <option {% if publication.city=="Gatineau" %}selected{% endif %}>Gatineau</option>
                    <option {% if publication.city=="Longueuil" %}selected{% endif %}>Longueuil</option>
                    <option {% if publication.city=="Sherbrooke" %}selected{% endif %}>Sherbrooke</option>
                    <option {% if publication.city=="Lévis" %}selected{% endif %}>Lévis</option>
                    <option {% if publication.city=="Saguenay" %}selected{% endif %}>Saguenay</option>
                    <option {% if publication.city=="Trois-Rivières" %}selected{% endif %}>Trois-Rivières
                    </option>
                    <option {% if publication.city=="Terrebonne" %}selected{% endif %}>Terrebonne</option>
                    <option {% if publication.city=="Saint-Jean-sur-Richelieu" %}selected{% endif %}>
                        Saint-Jean-sur-Richelieu
                    </option>
                    <option {% if publication.city=="Brossard" %}selected{% endif %}>Brossard</option>
                    <option {% if publication.city=="Repentigny" %}selected{% endif %}>Repentigny</option>
                    <option {% if publication.city=="Saint-Jérôme" %}selected{% endif %}>Saint-Jérôme</option>
                    <option {% if publication.city=="Drummondville" %}selected{% endif %}>Drummondville</option>
                </select>
                <div class="invalid-feedback">{{msg_ville}}</div>
            </div>
            <div class="col-md-6">
                <label for="province" class="form-label fw-bold">Province</label>
                <input type="text" class="form-control" id="province" value="Québec" disabled>
            </div>
            <div class="col-md-6">
                <div class="input-group">
                    <label for="prix" class="form-label input-group fw-bold">Prix</label>
                    <input type="number" class="form-control {{classe_prix}}" id="prix" name="prix"
                        value="{{publication.price}}">
                    <span class="input-group-text">$/heure</span>
                    <div class="invalid-feedback">{{msg_prix}}</div>
                </div>
            </div>
            <div class="col-md-6">
                <label for="place" class="form-label fw-bold ">Nombre de place</label>
                <input type="number" class="form-control {{classe_place}}" id="place" name="place"
                    value="{{publication.open_place}}">
                <div class="invalid-feedback">{{msg_place}}</div>
            </div>

            <div class="col-md-12 mt-3">
                <label for="emplacement" class="form-label fw-bold">Emplacement</label>
                <select id="emplacement" name="emplacement" class="form-select {{classe_emplacement}}">
                    <option value="" selected>Sélectionnez </option>
                    <option value="Intérieur" {% if publication.location=="Intérieur" %}selected{% endif %}>
                        Intérieur
                    </option>
                    <option value="Extérieur" {% if publication.location=="Extérieur" %}selected{% endif %}>
                        Extérieur
                    </option>
                </select>
                <div class="invalid-feedback">{{msg_emplacement}}</div>
            </div>
            <div class="col-md-6">
                <label for="dateDebut" class="form-label fw-bold">Disponible du :</label>
                <input type="datetime-local" class="form-control {{classe_debut}}" id="dateDebut" name="dateDebut"
                    value="{{publication.start}}" required>
                <div class="invalid-feedback">{{msg_debut}}</div>

            </div>
            <div class="col-md-6">
                <label for="dateFin" class="form-label fw-bold">Jusqu'au :</label>
                <input type="datetime-local" class="form-control {{classe_fin}}" id="dateFin" name="dateFin"
                    value="{{publication.end}}" required>
                <div class="invalid-feedback" id="msgFin">{{msg_fin}}</div>
            </div>

            <div class="d-grid gap-2  d-flex justify-content-end">
                <a href="/profile/detail" class="btn btn-outline-dark">Annuler</a>
                <button type="submit" class="btn btn-dark">Enregistrer les modifications</button>
            </div>
        </form>

    </div>

</div>

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <h2 class="h5 fw-bold mb-4">
            Image du stationnement
        </h2>

        {% if error %}
        <div class="alert alert-danger">
            {{ error }}
        </div>
        {% endif %}


        {% if img_success %}
        <div class="alert alert-success">{{ img_success }}</div>
        {% endif %}

        <form method="post" action="/stationnement/edit/{{ publication.id }}/image" enctype="multipart/form-data"
            novalidate>

            <div class="mb-3">
                <img src="{% if publication.img %} {{path~publication.img}} {%else%} {{url_for('static', filename='img/placeholder.jpg')}} {%endif%}"
                    class="card-img-top img-fluid" alt="image de l'annonce"
                    style="max-height: 300px; width: 100%; object-fit: cover;">
            </div>

            <div class="mb-2">
                <div class="d-flex align-items-center gap-2">
                    <input class="form-control" type="file" id="image" name="image">
                    <button type="submit" class="btn btn-dark text-nowrap">Remplacer</button>
                </div>
                {% if message_image %}
                <div class="invalid-feedback d-block mt-1">{{ message_image }}</div>
                {% endif %}
            </div>

        </form>


    </div>

</div>
{% endblock %}