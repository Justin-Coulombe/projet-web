{% extends "_modele.jinja" %}
{% block extra_head %}
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
{% endblock %}

{% block script %}

<script src="/static/js/base.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="{{ url_for('static', filename='js/geocoding.js') }}"></script>
{% endblock %}

{% block recherche%}
{% endblock %}

{% block contenu %}

<div class="d-flex flex-column align-items-center justify-content-center mt-3">
    <h2>Ajouter une place</h2>
    <p>Ajouter une place de stationnement facilement</p>
</div>
<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">
        <form id="ajout_form" class="row g-3" action="{{ url_for('stationnement.ajouter_stationnement') }}"
            enctype="multipart/form-data" method="post" novalidate data-ajax-form="parking" novalidate>
<input type="hidden" name="_csrf" value="{{ csrf_token() }}">
{% if errors %}<div class="alert alert-danger" role="alert" data-server-errors>{% for field, message in errors.items() %}<p class="mb-1">{{ message }}</p>{% endfor %}</div>{% endif %}

            <div class="col-md-12">
                <label for="adresse" class="form-label fw-bold">Adresse stationnement</label>
                <input type="text" name="adresse" class="form-control {{classe_adresse}}" id="adresse"
                    placeholder="133 boulevard de l'entente" value="{{adresse}}">
                <div class="invalid-feedback">{{msg_adresse}}</div>
            </div>

<div class="col-12">

    <label class="form-label fw-bold">
        Vérification de l'adresse
    </label>

    <div>
        <button
            type="button"
            id="verifier-adresse"
            class="btn btn-outline-primary">
            <i class="bi bi-geo-alt"></i>
            Vérifier l'adresse
        </button>
    </div>

    <p id="geocode-status"
       class="small mt-2"
       role="status"
       aria-live="polite"></p>

    <input
        type="hidden"
        id="geocode-token"
        name="geocode_token">

    {% if msg_position %}
    <p class="text-danger small">
        {{ msg_position }}
    </p>
    {% endif %}

    <div id="geocode-preview" hidden>
        <div class="alert alert-success">
            <strong>Adresse trouvée !</strong>
            <div id="adresse-reconnue"></div>
            <small>
                Vérifiez que le repère correspond
                à votre stationnement.
            </small>
        </div>

        <div id="geocode-map"
             style="height: 300px; width: 100%;"
             class="rounded border">
        </div>
    </div>

</div>


            <div class="col-md-6">
                <label for="ville" class="form-label fw-bold">Ville</label>
                <select id="ville" name="ville" class="form-select {{classe_ville}}">
                    <option selected value="">Choisissez la ville</option>
                    <option {% if ville=="Montréal" %}selected{% endif %}>Montréal</option>
                    <option {% if ville=="Québec" %}selected{% endif %}>Québec</option>
                    <option {% if ville=="Laval" %}selected{% endif %}>Laval</option>
                    <option {% if ville=="Gatineau" %}selected{% endif %}>Gatineau</option>
                    <option {% if ville=="Longueuil" %}selected{% endif %}>Longueuil</option>
                    <option {% if ville=="Sherbrooke" %}selected{% endif %}>Sherbrooke</option>
                    <option {% if ville=="Lévis" %}selected{% endif %}>Lévis</option>
                    <option {% if ville=="Saguenay" %}selected{% endif %}>Saguenay</option>
                    <option {% if ville=="Trois-Rivières" %}selected{% endif %}>Trois-Rivières</option>
                    <option {% if ville=="Terrebonne" %}selected{% endif %}>Terrebonne</option>
                    <option {% if ville=="Saint-Jean-sur-Richelieu" %}selected{% endif %}>Saint-Jean-sur-Richelieu
                    </option>
                    <option {% if ville=="Brossard" %}selected{% endif %}>Brossard</option>
                    <option {% if ville=="Repentigny" %}selected{% endif %}>Repentigny</option>
                    <option {% if ville=="Saint-Jérôme" %}selected{% endif %}>Saint-Jérôme</option>
                    <option {% if ville=="Drummondville" %}selected{% endif %}>Drummondville</option>
                </select>
                <div class="invalid-feedback">{{msg_ville}}</div>
            </div>

            <div class="col-md-6">
                <label for="province" class="form-label fw-bold">Province</label>
                <input type="text" class="form-control" id="province" value="Québec" disabled>
            </div>

            <div class="col-md-6">
                <div class="input-group">
                    <label for="prix" class="form-label input-group fw-bold">Prix</label>
                    <input type="number" class="form-control {{classe_prix}}" id="prix" name="prix" value="{{prix}}" min="0.01" max="1000" step="0.01" required>
                    <span class="input-group-text">$/heure</span>
                    <div class="invalid-feedback">{{msg_prix}}</div>

                </div>
            </div>

            <div class="col-md-6">
                <label for="place" class="form-label fw-bold">Nombre de place</label>
                <input type="number" class="form-control {{classe_place}}" id="place" name="place" value="{{place}}" min="1" max="100" step="1" required>
                <div class="invalid-feedback">{{msg_place}}</div>
            </div>

            <div class="col-md-12">
                <label for="emplacement" class="form-label fw-bold">Emplacement</label>
                <select id="emplacement" name="emplacement" class="form-select {{classe_emplacement}}">
                    <option selected value="">Sélectionnez</option>
                    <option value="Intérieur" {% if emplacement=="Intérieur" %}selected{% endif %}>Intérieur</option>
                    <option value="Extérieur" {% if emplacement=="Extérieur" %}selected{% endif %}>Extérieur</option>
                </select>
                <div class="invalid-feedback">{{msg_emplacement}}</div>
            </div>

            <fieldset class="border">
                <legend class="float-none w-auto px-2">Les disponibilités du stationnement</legend>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="dateDebut" class="form-label fw-bold">Disponible du :</label>
                        <input type="datetime-local" class="form-control {{classe_debut}}" id="dateDebut"
                            name="dateDebut" value="{{debut}}" required>
                        <div class="invalid-feedback">{{msg_debut}}</div>

                    </div>
                    <div class="col-md-6">
                        <label for="dateFin" class="form-label fw-bold">Jusqu'au :</label>
                        <input type="datetime-local" class="form-control {{classe_fin}}" id="dateFin" name="dateFin"
                            value="{{fin}}" required>
                        <div class="invalid-feedback" id="msgFin">{{msg_fin}}</div>

                    </div>
                </div>
            </fieldset>

            <label for="image" class="form-label fw-bold">Image du stationnement</label>
            <div class="input-group mb-3">
                <input type="file" class="form-control {{classe_image}}" id="image" name="image">
                <div class="invalid-feedback mb-3">{{message_image}}</div>
            </div>
            <div class="d-grid gap-2 col-6 mx-auto">
                <button type="submit" class="btn btn-dark">Publier la place de stationnement</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}