
{% extends "_modele.jinja" %}

{% block title %}
{{ publication.address }} | ParkShare
{% endblock %}

{% block body_class %}ps-parking-detail-page{% endblock %}

{% block page_layout %}

{% set est_proprietaire = session.get('user_id') == publication.author %}
{% set est_connecte = session.get('user_id') is not none %}
{% set prix_formate = "%.2f" | format(publication.price | float) | replace(".", ",") %}

<div class="ps-parking-detail">

    <div class="container-fluid ps-site-shell">

        <nav class="ps-detail-breadcrumb"
             aria-label="Fil d'Ariane">

            <a href="{{ url_for('index') }}">
                Accueil
            </a>

            <i class="bi bi-chevron-right"
               aria-hidden="true"></i>

            <a href="{{ url_for('publications.index', page=1) }}">
                Stationnements
            </a>

            <i class="bi bi-chevron-right"
               aria-hidden="true"></i>

            <span aria-current="page">
                Détail
            </span>

        </nav>

        <header class="ps-detail-header">

            <div>

                <span class="ps-detail-eyebrow">
                    DÉCOUVRIR UN STATIONNEMENT
                </span>

                <h1>{{ publication.address }}</h1>

                <p class="ps-detail-location">
                    <i class="bi bi-geo-alt"
                       aria-hidden="true"></i>

                    {{ publication.city }}, Québec
                </p>

            </div>

            {% if est_proprietaire %}

            <a href="{{ url_for('stationnement.edit', publication_id=publication.id) }}"
               class="btn ps-detail-outline-btn">

                <i class="bi bi-pencil-square me-2"
                   aria-hidden="true"></i>

                Modifier l'annonce
            </a>

            {% endif %}

        </header>

        <div class="ps-detail-main-grid">

            <div class="ps-detail-main-content">

                <section class="ps-detail-image-card"
                         aria-label="Photo du stationnement">

                    {% if publication.img %}

                    <img
                        src="{{ url_for('static', filename='img/stationnement/' ~ publication.img) }}"
                        alt="Stationnement situé au {{ publication.address }}"
                        class="ps-detail-image">

                    {% else %}

                    <img
                        src="{{ url_for('static', filename='img/placeholder.jpg') }}"
                        alt="Photo non disponible"
                        class="ps-detail-image">

                    {% endif %}

                </section>

                <section class="ps-detail-card">

                    <div class="ps-detail-section-heading">

                        <span class="ps-detail-section-label">
                            LE STATIONNEMENT
                        </span>

                        <h2>Tout ce qu'il faut savoir.</h2>

                        <p>
                            Les informations essentielles
                            sur cet emplacement.
                        </p>

                    </div>


                    <div class="ps-detail-features">

                        <div class="ps-detail-feature">

                            <div class="ps-detail-feature-icon">
                                <i class="bi bi-p-square"
                                   aria-hidden="true"></i>
                            </div>

                            <div>
                                <span>Type d'emplacement</span>

                                <strong>
                                    {{ publication.location }}
                                </strong>
                            </div>

                        </div>

                        <div class="ps-detail-feature">

                            <div class="ps-detail-feature-icon">
                                <i class="bi bi-car-front"
                                   aria-hidden="true"></i>
                            </div>

                            <div>
                                <span>Nombre de places</span>

                                <strong>
                                    {{ publication.place_total }}
                                    place{% if publication.place_total | int != 1 %}s{% endif %}
                                </strong>
                            </div>

                        </div>

                        <div class="ps-detail-feature">

                            <div class="ps-detail-feature-icon">
                                <i class="bi bi-geo-alt"
                                   aria-hidden="true"></i>
                            </div>

                            <div>
                                <span>Ville</span>

                                <strong>
                                    {{ publication.city }}
                                </strong>
                            </div>

                        </div>

                        <div class="ps-detail-feature">

                            <div class="ps-detail-feature-icon">
                                <i class="bi bi-cash-coin"
                                   aria-hidden="true"></i>
                            </div>

                            <div>
                                <span>Tarif horaire</span>

                                <strong>
                                    {{ prix_formate }} $ / heure
                                </strong>
                            </div>

                        </div>

                    </div>

                </section>

                <section class="ps-detail-card">

                    <div class="ps-detail-section-heading">

                        <span class="ps-detail-section-label">
                            LOCALISATION
                        </span>

                        <h2>Où se trouve ce stationnement ?</h2>

                        <p>
                            Consultez l'adresse de l'emplacement
                            avant votre réservation.
                        </p>

                    </div>

                    <div class="ps-detail-address">

                        <div class="ps-detail-address-icon">
                            <i class="bi bi-geo-alt-fill"
                               aria-hidden="true"></i>
                        </div>

                        <div>
                            <strong>
                                {{ publication.address }}
                            </strong>

                            <p>
                                {{ publication.city }},
                                Québec, Canada
                            </p>
                        </div>

                    </div>

                </section>

                <section class="ps-detail-availability">

                    <div class="ps-detail-availability-icon">
                        <i class="bi bi-calendar-check"
                           aria-hidden="true"></i>
                    </div>

                    <div>

                        <h2>Une place au bon moment.</h2>

                        <p>
                            Les disponibilités dépendent des
                            réservations existantes.
                            Sélectionnez vos dates pour vérifier
                            si une place est libre.
                        </p>

                    </div>

                </section>

            </div>

            <aside class="ps-detail-booking-column">

                <div class="ps-detail-booking-card">

                    <div class="ps-detail-booking-price">

                        <div>
                            <strong>
                                {{ prix_formate }} $
                            </strong>

                            <span>
                                / heure
                            </span>
                        </div>

                        <span class="ps-detail-booking-price-caption">
                            Tarif du stationnement
                        </span>

                    </div>


                    <div class="ps-detail-booking-divider"></div>


                    {% if est_proprietaire %}

                    <div class="ps-detail-owner">

                        <div class="ps-detail-owner-icon">
                            <i class="bi bi-house-check"
                               aria-hidden="true"></i>
                        </div>

                        <h2>C'est votre stationnement.</h2>

                        <p>
                            Vous pouvez modifier les informations
                            et la photo de cette annonce depuis
                            votre espace personnel.
                        </p>

                        <a href="{{ url_for('stationnement.edit', publication_id=publication.id) }}"
                           class="btn ps-detail-primary-btn">

                            <i class="bi bi-pencil-square me-2"
                               aria-hidden="true"></i>

                            Gérer mon annonce
                        </a>

                        <a href="{{ url_for('detail.mes_reservations') }}"
                           class="ps-detail-secondary-link">

                            Voir mes réservations
                            <i class="bi bi-arrow-up-right"
                               aria-hidden="true"></i>

                        </a>

                    </div>


                    {% elif not est_connecte %}

                    <div class="ps-detail-guest">

                        <h2>Réserver ce stationnement</h2>

                        <p>
                            Connectez-vous à votre compte ParkShare
                            pour choisir vos dates et effectuer
                            une réservation.
                        </p>

                        <a href="{{ url_for('auth.login') }}"
                           class="btn ps-detail-primary-btn">

                            Se connecter pour réserver

                            <i class="bi bi-arrow-up-right ms-1"
                               aria-hidden="true"></i>

                        </a>

                        <p class="ps-detail-guest-register">
                            Pas encore de compte ?

                            <a href="{{ url_for('auth.register') }}">
                                S'inscrire
                            </a>
                        </p>

                    </div>


                    {% else %}

                    <div class="ps-detail-booking-form">

                        <h2>Réserver ce stationnement</h2>

                        <p class="ps-detail-booking-intro">
                            Choisissez votre période de stationnement
                            et vérifiez les disponibilités.
                        </p>

                        <form method="POST"
                              action="{{ url_for('stationnement.detail', publication_id=publication.id) }}"
                              id="ps-booking-form" novalidate>

                            <input type="hidden"
                                   name="_csrf"
                                   value="{{ csrf_token() }}">


                            <div class="ps-detail-booking-field">

                                <label for="date_du"
                                       class="form-label">
                                    Date et heure d'arrivée
                                </label>

                                <input
                                    type="datetime-local"
                                    id="date_du"
                                    name="date_du"
                                    class="form-control"
                                    value="{{ form.get('date_du', '') }}"
                                    required>

                            </div>


                            <div class="ps-detail-booking-field">

                                <label for="date_au"
                                       class="form-label">
                                    Date et heure de départ
                                </label>

                                <input
                                    type="datetime-local"
                                    id="date_au"
                                    name="date_au"
                                    class="form-control"
                                    value="{{ form.get('date_au', '') }}"
                                    required>

                            </div>


                            {% if context.message %}

                            <div
                                class="ps-detail-booking-message {{ 'ps-detail-message-success' if context.can_submit else 'ps-detail-message-error' }}"
                                role="status">

                                <i class="bi {{ 'bi-check-circle' if context.can_submit else 'bi-exclamation-circle' }}"
                                   aria-hidden="true"></i>

                                <span>
                                    {{ context.message }}
                                </span>

                            </div>

                            {% endif %}


                            <button
                                type="submit"
                                name="btn_submit"
                                value="verification"
                                class="btn ps-detail-outline-btn ps-detail-booking-verify">

                                <i class="bi bi-calendar-check me-2"
                                   aria-hidden="true"></i>

                                Vérifier la disponibilité

                            </button>


                            <button
                                type="submit"
                                name="btn_submit"
                                value="reservation"
                                id="ps-confirm-reservation"
                                class="btn ps-detail-primary-btn"
                                {% if not context.can_submit %}disabled{% endif %}>

                                <i class="bi bi-check-circle me-2"
                                   aria-hidden="true"></i>

                                Confirmer la réservation

                            </button>

                        </form>


                        <p class="ps-detail-booking-note">

                            <i class="bi bi-info-circle"
                               aria-hidden="true"></i>

                            Vérifiez la disponibilité avant
                            de confirmer votre réservation.

                        </p>

                    </div>

                    {% endif %}

                </div>

            </aside>

        </div>

    </div>

</div>

{% endblock %}


{% block script %}
<script src="{{ url_for('static', filename='js/base.js') }}"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const arrivee = document.getElementById("date_du");
    const depart = document.getElementById("date_au");
    const confirmation = document.getElementById("ps-confirm-reservation");

    if (!arrivee || !depart || !confirmation) {
        return;
    }
    function invaliderVerification() {
        confirmation.disabled = true;
    }

    arrivee.addEventListener("input", invaliderVerification);
    arrivee.addEventListener("change", invaliderVerification);

    depart.addEventListener("input", invaliderVerification);
    depart.addEventListener("change", invaliderVerification);
});
</script>
{% endblock %}
