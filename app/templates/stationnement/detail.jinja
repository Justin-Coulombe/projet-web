{% extends "_modele.jinja" %}

{% block title %}
stationnement | ParkShare
{% endblock %}

{% block recherche%}
{% endblock %}
{% set path = "/static/img/stationnement/" %}

{% block contenu%}

<div class="d-flex align-items-center justify-content-between mb-4 mt-3">
    <h2 class=" fw-bold"> Détails de l’annonce</h2>
    {% if session.get('user_id') == publication.author %}
    <a href="/stationnement/edit/{{publication.id}}" class="btn btn-dark">Modifier l'annonce</a>
    {% endif %}

</div>
<div class="mb-3">
    <img src="{% if publication.img %} {{path~publication.img}} {%else%} {{url_for('static', filename='img/placeholder.jpg')}} {%endif%}"
        class="card-img-top img-fluid" alt="image de l'annonce"
        style="max-height: 300px; width: 100%; object-fit: cover;">
</div>
<ul class="list-group list-group-flush">
    <li class="list-group-item border border-0 border-bottom border-2 border-tertiary mb-2">
        <div class="row">
            <div class="col-6 d-flex flex-column">
                <span class="fw-lighter">Adresse stationnement</span>
                {{publication.address}}
            </div>
            <div class="col-6 d-flex flex-column">
                <span class="fw-lighter">Prix ($/heure)</span>
                {{publication.price}}
            </div>
        </div>
    </li>
    <li class="list-group-item border border-0 border-bottom border-2 border-tertiary mb-2">
        <div class="row">
            <div class="col-6 d-flex flex-column">
                <span class="fw-lighter">Place</span>
                {{ publication.placeTotal}}
            </div>
            <div class="col-6 d-flex flex-column">
                <span class="fw-lighter">Emplacement</span>
                {{publication.location}}
            </div>
        </div>
    </li>
    <li class="list-group-item border border-0 border-bottom border-2 border-tertiary mb-2">
        <div class="row">
            <div class="col-6 d-flex flex-column">
                <span class="fw-lighter">Ville</span>
                {{publication.city}}
            </div>
            <div class="col-6 d-flex flex-column fw-bold">
                <span class="fw-lighter">Province</span>
                Québec
            </div>
        </div>
    </li>
    {% if session.get('user_id')%}
    <li class="list-group-item border border-0 border-bottom border-2 border-tertiary mb-2">
        <form method="post" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <div class="row">
                <div class="col-6 d-flex flex-column">
                    <span class="fw-lighter">Du</span>
                    <input class="is-invalid" type="datetime-local" name="date_du" value="{{form.get('date_du', '')}}">
                </div>
                <div class="col-6 d-flex flex-column fw-bold">
                    <span class="fw-lighter">Au</span>
                    <input class="{%if not context.v_time %} is-invalid {% endif %}" type="datetime-local" name="date_au" value="{{form.get('date_au', '')}}">
                    <div class="invalid-feedback">la fin doit suivre le début</div>
                </div>
            </div>
            <div class="{% if not context.can_submit %} text-danger {%else%} text-success {%endif%}">
                {{context.message}}
            </div>
            <div class="mt-3 d-flex justify-content-between">
                <button class="btn btn-dark" type="submit" value="verification" name="btn_submit">verifier disponibilité</button>
                <button class="btn btn-dark" type="submit" value="reservation" name="btn_submit" {% if not context.can_submit %} disabled {%endif%} >Réserver la place</button>
            </div>
            
        </form>
    </li>
    {%endif%}

</ul>

{% endblock %}