{% extends '_modele.jinja' %}
{% block title%}
Administration | ParkShare
{%endblock%}

{% block centered_title%}
<div class="fs-3 m-2 fw-bold">connexion administrateur</div>
{%endblock%}

{% block recherche%}
{%endblock%}

{% block contenu %}
<div class="row g-8 justify-content-center">
    <div class="w-100 h-100 d-flex justify-content-center align-items-center">
        
        <form class="bg-secondary p-3 rounded-2 needs-validation"  method="post" novalidate>
            <div {%if not context.messages %} hidden {%endif%} class="bg-danger text-white m-2 rounded-2">
                <p class="ms-2">Connexion refusée:</p>
                <ul>
                    {% for message in context.messages%}
                    <li>{{message}}</li>
                    {% endfor %}
                </ul>   
            </div>
            <div class="d-flex">
                <div class="m-2">
                    <label class="text-white form-label" for="inputidentifier">nom d'identification</label>
                    <input type="text" name="inputidentifier" id="inputidentifier" class="form-control {% if not context.valid %} is-invalid {%endif%}">
                </div>
                <div class="m-2">
                    <label class="text-white form-label" for="inputpassword">mot de passe</label>
                    <input type="password" id="inputpassword" name="inputpassword" class="form-control {% if not context.valid %} is-invalid {%endif%}">
                </div>
            </div>
            <div class="m-2 d-flex justify-content-between align-items-center">
                <a class="btn btn-outline-light w-25" href="{{url_for(request.endpoint)}}">nettoyer</a>
                <button type="submit" class="w-25 btn btn-dark">connexion</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}