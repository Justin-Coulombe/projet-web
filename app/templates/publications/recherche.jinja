
{% extends "_modele.jinja" %}

{% block title %}
Recherche | ParkShare
{% endblock %}

{% block body_class %}ps-recherche-page{% endblock %}

{% block extra_head %}
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
{% endblock %}

{% block page_layout %}

{% set selected_city = request.args.get('ville', '') %}
{% set selected_filter = request.args.get('filter', 'Tous') %}

<div class="ps-recherche">

    <div class="container-fluid ps-site-shell">

        <!-- EN-TÊTE -->
        <header class="ps-recherche-header">

            <span class="ps-publications-eyebrow">
                Explorer ParkShare
            </span>

            <h1>Un stationnement près de vous.</h1>

            <p>
                Explorez les places disponibles sur la carte
                et trouvez celle qui vous convient.
            </p>

        </header>

        <!-- RECHERCHE -->
        <section class="ps-publications-search-section"
                 aria-label="Rechercher un stationnement">

            <form action="/publications/recherche"
                  method="GET"
                  id="research"
                  class="ps-publications-search needs-validation"
                  novalidate>

                <div class="ps-publications-search-grid">

                    <!-- VILLE -->
                    <div class="ps-publications-search-field">

                        <label for="ville" class="form-label">
                            Ville
                        </label>

                        <select id="ville"
                                name="ville"
                                class="form-select {{ classe_ville | default('') }}">

                            <option value="">
                                Toutes les villes
                            </option>

                            {% for nom_ville in [
                                "Montréal",
                                "Québec",
                                "Laval",
                                "Gatineau",
                                "Longueuil",
                                "Sherbrooke",
                                "Lévis",
                                "Saguenay",
                                "Trois-Rivières",
                                "Terrebonne",
                                "Saint-Jean-sur-Richelieu",
                                "Brossard",
                                "Repentigny",
                                "Saint-Jérôme",
                                "Drummondville"
                            ] %}

                            <option value="{{ nom_ville }}"
                                {% if selected_city == nom_ville %}
                                    selected
                                {% endif %}>
                                {{ nom_ville }}
                            </option>

                            {% endfor %}

                        </select>

                    </div>

                    <!-- ARRIVÉE -->
                    <div class="ps-publications-search-field">

                        <label for="debut" class="form-label">
                            Arrivée
                        </label>

                        <input type="datetime-local"
                               id="debut"
                               name="debut"
                               class="form-control"
                               value="{{ request.args.get('debut', '') }}">

                    </div>

                    <!-- DÉPART -->
                    <div class="ps-publications-search-field">

                        <label for="fin" class="form-label">
                            Départ
                        </label>

                        <input type="datetime-local"
                               id="fin"
                               name="fin"
                               class="form-control">

                    </div>

                    <!-- EMPLACEMENT -->
                    <div class="ps-publications-search-field">

                        <label for="filter" class="form-label">
                            Emplacement
                        </label>

                        <select id="filter"
                                name="filter"
                                class="form-select">

                            <option value="Tous"
                                {% if selected_filter == 'Tous' %}
                                    selected
                                {% endif %}>
                                Tous
                            </option>

                            <option value="Intérieur"
                                {% if selected_filter == 'Intérieur' %}
                                    selected
                                {% endif %}>
                                Intérieur
                            </option>

                            <option value="Extérieur"
                                {% if selected_filter == 'Extérieur' %}
                                    selected
                                {% endif %}>
                                Extérieur
                            </option>

                        </select>

                    </div>

                    <!-- RECHERCHER -->
                    <div class="ps-publications-search-submit">

                        <button id="submit_btn"
                                type="submit"
                                class="btn ps-publications-search-button">

                            <i class="bi bi-search me-2"></i>
                            Rechercher

                        </button>

                    </div>

                </div>

            </form>

        </section>

        <!-- RÉSULTATS ET CARTE -->
        <section class="ps-recherche-results-section">

            <div class="row g-4">

                <!-- LISTE DES RÉSULTATS -->
                <div class="col-12 col-lg-5">

                    <div class="ps-recherche-results-panel">

                        <div class="ps-recherche-results-header">

                            <h2 class="ps-recherche-results-title">
                                Stationnements trouvés
                            </h2>

                            <p class="ps-recherche-results-count">
                                <span id="nb_results">0</span>
                                stationnement(s) dans cette zone
                            </p>

                        </div>

                        <div id="liste-stationnements"
                             class="list-group ps-recherche-list">

                            <p class="text-muted p-3 mb-0">
                                Chargement des stationnements...
                            </p>

                        </div>

                    </div>

                </div>

                <!-- CARTE LEAFLET -->
                <div class="col-12 col-lg-7">

                    <div class="ps-recherche-map-panel">

                        <div class="ps-recherche-map-header">

                            <div>
                                <h2>Explorer la carte</h2>
                                <p>
                                    Déplacez la carte pour découvrir
                                    d'autres stationnements.
                                </p>
                            </div>

                            <i class="bi bi-geo-alt"
                               aria-hidden="true"></i>

                        </div>

                        <div id="carte-recherche"
                             aria-label="Carte des stationnements">
                        </div>

                        <p id="carte-message"
                           class="ps-recherche-map-message"
                           role="status"
                           aria-live="polite">
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </div>

</div>

{% endblock %}

{% block script %}
<script src="{{ url_for('static', filename='js/base.js') }}"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="{{ url_for('static', filename='js/carte-recherche.js') }}"></script>
{% endblock %}
