{% extends '_modele.jinja' %}

{% block title %}
Publications | ParkShare
{% endblock %}

{%block centered_title %}
<div class="mx-auto p-2">
    <h2>TOUTES LES PUBLICATIONS</h2>
</div>
{%endblock%}
{% block recherche%}
<form action="/publications/recherche" method="get" id="research" class=" rounded-3 p-1 mx-auto needs-validation pb-4"
    style="max-width: 1100px;" novalidate>
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group border rounded-3">
                <span class="input-group-text bg-white border-0"><i class="bi bi-geo-alt"></i></span>
                <select id="ville" name="ville" class="form-select {{classe_ville}} border-0">
                    <option selected value=""> Sélectionnez la ville</option>
                    <option {% if ville=="Montréal" %}selected{% endif %}>Montréal</option>
                    <option {% if ville=="Québec" %}selected{% endif %}>Québec</option>
                    <option {% if ville=="Laval" %}selected{% endif %}>Laval</option>
                    <option {% if ville=="Gatineau" %}selected{% endif %}>Gatineau</option>
                    <option {% if ville=="Longueuil" %}selected{% endif %}>Longueuil</option>
                    <option {% if ville=="Sherbrooke" %}selected{% endif %}>Sherbrooke</option>
                    <option {% if ville=="Lévis" %}selected{% endif %}>Lévis</option>
                    <option {% if ville=="Saguenay" %}selected{% endif %}>Saguenay</option>
                    <option {% if ville=="Trois-Rivières" %}selected{% endif %}>Trois-Rivières</option>
                    <option {% if ville=="Terrebonne" %}selected{% endif %}>Terrebonne</option>
                    <option {% if ville=="Saint-Jean-sur-Richelieu" %}selected{% endif %}>
                        Saint-Jean-sur-Richelieu</option>
                    <option {% if ville=="Brossard" %}selected{% endif %}>Brossard</option>
                    <option {% if ville=="Repentigny" %}selected{% endif %}>Repentigny</option>
                    <option {% if ville=="Saint-Jérôme" %}selected{% endif %}>Saint-Jérôme</option>
                    <option {% if ville=="Drummondville" %}selected{% endif %}>Drummondville</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <input name="debut" type="datetime-local" class="form-control" aria-label="Date de début">
        </div>
        <div class="col-md-2">
            <input name="fin" type="datetime-local"
                class="form-control {%if not context.valid_time %} is-invalid {%endif%}" aria-label="Date de fin">
            <div class="invalid-feedback">{{context.time_message}}</div>
        </div>
        <div class="col-md-2">
            <select class="form-select" name="filter">
                <option selected value="Tous">Tous</option>
                <option value="Intérieur">Intérieur</option>
                <option value="Extérieur">Extérieur</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button id="submit_btn" type="submit" class="bi bi-search btn btn-dark"> Rechercher</button>
        </div>
    </div>
</form>
{% endblock %}

{%block contenu %}
<ul class="list-unstyled row row-cols-4">
    {% set path = "/static/img/stationnement/" %}
    {% for item in context.publications %}
    <li class="col m-2">
        <a href="/stationnement/detail/{{item.id}}" class="d-flex link-underline link-underline-opacity-0">
            <div class="card">
                <img class="card-img-top"
                    src="{% if item.img %} {{path~item.img}} {%else%} {{url_for('static', filename='img/placeholder.jpg')}} {%endif%}"
                    alt="photo de la place">
                <div class="card-body">
                    <p class="fw-bold mb-0">{{item.address}}, {{item.city}}</p>
                    <span class="fw-bold mb-1">{{item.price}}$<span class="fw-lighter"> /heure</span>
                    <div class="d-flex justify-content-start align-items-center">
                        <span class="card-text bi bi-house text-muted small me-3"> {{item.location}} </span>
                        <span class="card-text bi bi-geo-alt small me-3"> {{item.open_place}} place(s) </span>
                        {% if item.place_use == item.open_place %}
                        <span class="badge rounded-3 bg-success fs-5"> Disponible </span>
                        {% else %}
                        <span class="badge rounded-3 bg-danger fs-5">Indisponible</span>
                        {% endif %}
                    </div>
                </div>

            </div>
        </a>
    </li>
    {%endfor%}
</ul>

<nav aria-label="Page navigation example">
    <ul class="pagination justify-content-center">
        {%if request.args.page %}
        {% for page in range(context.page_number|int)%}
        <li class="page-item"><a class="page-link text-dark btn-outline-dark {%if request.args.page|int == page+1 %} active {%endif%}" href="{{url_for(request.endpoint, **dict(request.args, page=page+1) )}}">{{page + 1}}</a></li>
        {% endfor%}
        {%else%}
        <li class="page-item"><a class="page-link btn-outline-dark active text-dark" href="{{url_for(request.endpoint, **dict(request.args, page=page+1))}}">1</a></li>
        {%endif%}
    </ul>
</nav>
{%endblock%}