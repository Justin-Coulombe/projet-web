
{% extends "_modele.jinja" %}

{% block title %}
Tous les stationnements | ParkShare
{% endblock %}

{% block body_class %}ps-publications-page{% endblock %}

{% block page_layout %}

{% set publications = context.publications | default([]) %}
{% set total_pages = context.page_number | default(1) | int %}
{% set current_page = request.args.get('page', 1) | int %}
{% set image_fallback = url_for('static', filename='img/placeholder.jpg') %}

<div class="ps-publications">

    <div class="container-fluid ps-site-shell">

        <header class="ps-publications-header">

            <span class="ps-publications-eyebrow">
                Explorer ParkShare
            </span>

            <h1>Une place pour chaque destination.</h1>

            <p>
                Comparez les stationnements privés,
                partout au Québec.
            </p>

        </header>

        <section class="ps-publications-search-section"
                 aria-label="Rechercher un stationnement">

            <form
                action="/publications/recherche"
                method="GET"
                id="research"
                class="ps-publications-search needs-validation"
                novalidate>

                <div class="ps-publications-search-grid">

                    <div class="ps-publications-search-field">

                        <label for="ville" class="form-label">
                            Ville
                        </label>

                        <select
                            id="ville"
                            name="ville"
                            class="form-select {{ classe_ville | default('') }}">

                            <option value="">
                                Toutes les villes
                            </option>

                            {% for nom_ville in [
                                "Montréal",
                                "Québec",
                                "Laval",
                                "Gatineau",
                                "Longueuil",
                                "Sherbrooke",
                                "Lévis",
                                "Saguenay",
                                "Trois-Rivières",
                                "Terrebonne",
                                "Saint-Jean-sur-Richelieu",
                                "Brossard",
                                "Repentigny",
                                "Saint-Jérôme",
                                "Drummondville"
                            ] %}

                                <option
                                    value="{{ nom_ville }}"
                                    {% if request.args.get('ville', '') == nom_ville %}
                                        selected
                                    {% endif %}>

                                    {{ nom_ville }}

                                </option>

                            {% endfor %}

                        </select>

                    </div>

                    <div class="ps-publications-search-field">

                        <label for="debut" class="form-label">
                            Arrivée
                        </label>

                        <input
                            type="datetime-local"
                            id="debut"
                            name="debut"
                            class="form-control"
                            value="{{ request.args.get('debut', '') }}"
                            aria-label="Date et heure d'arrivée">

                    </div>

                    <div class="ps-publications-search-field">

                        <label for="fin" class="form-label">
                            Départ
                        </label>

                        <input
                            type="datetime-local"
                            id="fin"
                            name="fin"
                            class="form-control {% if context.valid_time is defined and not context.valid_time %}is-invalid{% endif %}"
                            value="{{ request.args.get('fin', '') }}"
                            aria-label="Date et heure de départ">

                        <div class="invalid-feedback">
                            {{ context.time_message | default('') }}
                        </div>

                    </div>

                    <div class="ps-publications-search-field">

                        <label for="filter" class="form-label">
                            Emplacement
                        </label>

                        <select
                            id="filter"
                            name="filter"
                            class="form-select">

                            <option value="Tous"
                                {% if request.args.get('filter', 'Tous') == 'Tous' %}
                                    selected
                                {% endif %}>
                                Tous
                            </option>

                            <option value="Intérieur"
                                {% if request.args.get('filter') == 'Intérieur' %}
                                    selected
                                {% endif %}>
                                Intérieur
                            </option>

                            <option value="Extérieur"
                                {% if request.args.get('filter') == 'Extérieur' %}
                                    selected
                                {% endif %}>
                                Extérieur
                            </option>

                        </select>

                    </div>

                    <div class="ps-publications-search-submit">

                        <button
                            id="submit_btn"
                            type="submit"
                            class="btn ps-publications-search-button">

                            Rechercher

                        </button>

                    </div>

                </div>

            </form>

        </section>

        <section class="ps-publications-results">

            <div class="ps-publications-section-heading">

                <h2>Tous les stationnements</h2>

                <a
                    href="/publications/recherche"
                    class="ps-publications-map-link">

                    Vue liste et carte

                    <i class="bi bi-arrow-up-right"
                       aria-hidden="true"></i>

                </a>

            </div>


            {% if publications %}

                <div class="row g-4">

                    {% for item in publications %}

                        <div class="col-12 col-md-6 col-lg-4 d-flex">

                            <a
                                href="{{ url_for('stationnement.detail', publication_id=item.id) }}"
                                class="ps-publications-card">

                                <div class="ps-publications-card-image-wrapper">

                                    {% if item.img %}
                                        <img
                                            src="{{ url_for('static', filename='img/stationnement/' ~ item.img) }}"
                                            alt="Stationnement situé au {{ item.address }}"
                                            class="ps-publications-card-image"
                                            loading="lazy">
                                    {% else %}
                                        <img
                                            src="{{ image_fallback }}"
                                            alt="Photo non disponible"
                                            class="ps-publications-card-image"
                                            loading="lazy">
                                    {% endif %}

                                </div>

                                <div class="ps-publications-card-body">

                                    <span class="ps-publications-card-city">
                                        {{ item.city }}
                                    </span>

                                    <h3 class="ps-publications-card-title">
                                        {{ item.address }}
                                    </h3>

                                    <p class="ps-publications-card-meta">

                                        {{ item.location }}

                                        <span aria-hidden="true">·</span>

                                        {{ item.place_total }}
                                        place{% if item.place_total | int != 1 %}s{% endif %}

                                    </p>

                                    <div class="ps-publications-card-footer">

                                        <div class="ps-publications-card-price">

                                            <strong>
                                                {{ "%.2f" | format(item.price | float) | replace(".", ",") }} $
                                            </strong>

                                            <span>/ heure</span>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>

                    {% endfor %}

                </div>

            {% else %}

            <div class="ps-publications-empty">

                    <i class="bi bi-p-square"></i>

                    <h3>Aucun stationnement trouvé</h3>

                    <p>
                        Aucun stationnement n'est disponible
                        dans cette liste pour le moment.
                    </p>

                    <a
                        href="/publications/recherche"
                        class="btn ps-publications-search-button">

                        Explorer la carte

                    </a>

                </div>

            {% endif %}

        </section>

        {% if total_pages > 1 %}

            <nav
                class="ps-publications-pagination"
                aria-label="Pagination des stationnements">

                <ul class="pagination justify-content-center align-items-center">

                    <li class="page-item {% if current_page <= 1 %}disabled{% endif %}">

                        <a
                            class="page-link ps-pagination-arrow"
                            href="{% if current_page > 1 %}{{ url_for(request.endpoint, **dict(request.args, page=current_page-1)) }}{% else %}#{% endif %}"
                            {% if current_page <= 1 %}aria-disabled="true" tabindex="-1"{% endif %}
                            aria-label="Page précédente">

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </li>


                    {% for page in range(1, total_pages + 1) %}

                        {% if page == 1
                              or page == total_pages
                              or (page >= current_page - 1 and page <= current_page + 1) %}

                            <li class="page-item">

                                <a
                                    class="page-link {% if current_page == page %}active{% endif %}"
                                    href="{{ url_for(request.endpoint, **dict(request.args, page=page)) }}"
                                    {% if current_page == page %}aria-current="page"{% endif %}>

                                    {{ page }}

                                </a>

                            </li>

                        {% elif page == 2 and current_page > 3
                              or page == total_pages - 1 and current_page < total_pages - 2 %}

                            <li class="page-item disabled">

                                <span class="page-link ps-pagination-ellipsis">
                                    …
                                </span>

                            </li>

                        {% endif %}

                    {% endfor %}

                    <li class="page-item {% if current_page >= total_pages %}disabled{% endif %}">

                        <a
                            class="page-link ps-pagination-arrow"
                            href="{% if current_page < total_pages %}{{ url_for(request.endpoint, **dict(request.args, page=current_page+1)) }}{% else %}#{% endif %}"
                            {% if current_page >= total_pages %}aria-disabled="true" tabindex="-1"{% endif %}
                            aria-label="Page suivante">

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        {% endif %}

    </div>

</div>

{% endblock %}
