<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <title>{% block title %}Accueil | ParkShare{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="https://www.cegepgarneau.ca/favicon.ico">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="{{url_for('static', filename='js/utils_ajax.js')}}"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</head>

<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="/">ParkShare</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto medium">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="/">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/publications">Publications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/publications/recherche">Rechercher</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#how">Comment ça marche ?</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/stationnement/ajouter">À propos</a>
                        </li>
                    </ul>
                    <div class="d-flex gap-2">
                        {% if not session['user_id']%}
                        <a href="/auth/login" class="btn btn-outline-secondary btn-sm">Se connecter</a>
                        <a href="/auth/register" class="btn btn-dark btn-sm">S'inscrire</a>
                        {% else %}
                        <a href="/auth/logout" class="btn btn-dark btn-sm">Déconnexion</a>
                        {%endif%}
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        {%block centered_title %}
        {% endblock %}
        {% block recherche %}
        {% endblock %}
        <section>
            <div class="row m-2">
                {% block contenu %}
                {%endblock%}
            </div>
        </section>
        {%block section_how %}
        {% endblock %}
    </main>
    <footer class="bg-dark text-white pt-5 pb-3 mt-auto">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-4">
                    <h4 class="fw-bold fs-5 mb-2">ParkShare</h4>
                    <p class="small text-secondary">Des espaces mieux utilisés, pour une ville <br>plus accessible.</p>
                </div>
                <div class="col-6 col-md-3">
                    <h4 class="fw-bold fs-5 mb-2">Collaborateurs</h4>
                    <p class="small text-secondary">Justin Coulombe,<br>Maximilien Djabia,<br>Yao Pascal Joseph Yao.
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <h4 class="fw-bold fs-5 mb-2">Légal</h4>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="text-secondary text-decoration-none">Conditions d'utilisation</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Politique de confidentialité</a>
                        </li>
                        <li><a href="#" class="text-secondary text-decoration-none">Nous contacter</a></li>
                    </ul>
                </div>
                <div class="col-md-2 text-md-end fs-5">
                    <i class="bi bi-facebook me-2"></i><i class="bi bi-instagram me-2"></i><i class="bi bi-twitter"></i>
                </div>
            </div>
            <hr class="border-secondary mt-4">
            <p class="small text-secondary mb-0">© 2026 ParkShare. Tous droits réservés.</p>
        </div>
    </footer>
</body>
{%block script%}
<script src="{{url_for('static', filename='js/base.js')}}"></script>
{%endblock%}

</html>