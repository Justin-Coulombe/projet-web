<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#173c32">
    <meta name="csrf-token" content="{{ csrf_token() }}">

    <title>{% block title %}Accueil | ParkShare{% endblock %}</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">

    {% block extra_head %}{% endblock %}

    <script defer src="{{ url_for('static', filename='js/utils_ajax.js') }}"></script>
    <script defer
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
    <script defer src="{{ url_for('static', filename='js/forms-validation.js') }}"></script>
    <script defer src="{{ url_for('static', filename='js/search-validation.js') }}"></script>
</head>

<body class="d-flex flex-column min-vh-100 ps-body {% block body_class %}{% endblock %}">
    {% set current_endpoint = request.endpoint or '' %}
    {% set user_logged_in = g.get('user') is not none %}

    <header class="ps-site-header">
        <nav class="navbar navbar-expand-lg ps-navbar" aria-label="Navigation principale">
            <div class="container-fluid ps-site-shell">

                <a class="navbar-brand ps-brand" href="{{ url_for('index') }}" aria-label="ParkShare - Accueil">
                    <span class="ps-brand-mark" aria-hidden="true">P</span>
                    <span>ParkShare</span>
                </a>

                <button class="navbar-toggler ps-navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false"
                        aria-label="Afficher le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ps-navbar-links mx-lg-auto">
                        <li class="nav-item">
                            <a class="nav-link {% if current_endpoint == 'index' %}active{% endif %}"
                               {% if current_endpoint == 'index' %}aria-current="page"{% endif %}
                               href="{{ url_for('index') }}">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if request.blueprint == 'publications' %}active{% endif %}"
                               {% if request.blueprint == 'publications' %}aria-current="page"{% endif %}
                               href="{{ url_for('publications.index', page=1) }}">Stationnements</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if current_endpoint == 'detail.detail_profil' %}active{% endif %}"
                               {% if current_endpoint == 'detail.detail_profil' %}aria-current="page"{% endif %}
                               href="{{ url_for('detail.detail_profil') if user_logged_in else url_for('auth.login') }}">
                                Mes réservations
                            </a>
                        </li>
                    </ul>

                    <div class="ps-navbar-actions d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                        <a class="btn ps-nav-cta" href="{{ url_for('stationnement.ajouter_stationnement') }}">
                            <span aria-hidden="true">+</span> Proposer une place
                        </a>

                        {% if user_logged_in %}
                            <div class="dropdown">
                                <button class="btn ps-account-link dropdown-toggle"
                                        type="button" data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    Mon compte
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end ps-account-menu">
                                    <li>
                                        <a class="dropdown-item" href="{{ url_for('detail.detail_profil') }}">
                                            <i class="bi bi-person me-2"></i>Mon espace
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="{{ url_for('auth.logout') }}" method="post"
                                              data-ajax-form="logout">
                                            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                                            <button class="dropdown-item" type="submit">
                                                <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        {% else %}
                            <a class="ps-account-link text-decoration-none" href="{{ url_for('auth.login') }}">
                                Se connecter <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                            </a>
                            <a class="ps-register-link text-decoration-none" href="{{ url_for('auth.register') }}">
                                S'inscrire
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="contenu-principal" class="flex-grow-1 ps-main">
        {% block page_layout %}
            <div class="ps-page-heading">
                {% block centered_title %}{% endblock %}
            </div>

            <div class="ps-page-search">
                {% block recherche %}{% endblock %}
            </div>

            <section class="container ps-content">
                {% block contenu %}{% endblock %}
            </section>

            {% block section_how %}{% endblock %}
        {% endblock %}
    </main>

    <footer class="ps-site-footer mt-auto">
        <div class="container-fluid ps-site-shell">
            <div class="row g-4 ps-footer-columns">
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="ps-footer-brand text-decoration-none" href="{{ url_for('index') }}">
                        ParkShare
                    </a>
                    <p class="ps-footer-description mt-2 mb-0">
                        Des espaces mieux utilisés,<br>
                        pour une ville plus accessible.
                    </p>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h2 class="ps-footer-title">Explorer</h2>
                    <ul class="list-unstyled mb-0">
                        <li><a class="ps-footer-link" href="{{ url_for('index') }}">Accueil</a></li>
                        <li><a class="ps-footer-link" href="{{ url_for('publications.index', page=1) }}">Stationnements</a></li>
                        <li>
                            <a class="ps-footer-link"
                               href="{{ url_for('detail.detail_profil') if user_logged_in else url_for('auth.login') }}">
                                Mes réservations
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-3">
                    <h2 class="ps-footer-title">À votre écoute</h2>
                    <ul class="list-unstyled mb-0">
                        <li><span class="ps-footer-link ps-footer-pending">Nous contacter</span></li>
                        <li>
                            <a class="ps-footer-link" href="{{ url_for('conditions_utilisation') }}">
                                Conditions d'utilisation
                            </a>
                        </li>
                        <li><span class="ps-footer-link ps-footer-pending">Confidentialité</span></li>
                    </ul>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <h2 class="ps-footer-title">Un projet collaboratif</h2>
                    <p class="ps-footer-description mb-0">
                        Yao Pascal Joseph Yao<br>
                        Justin Coulombe<br>
                        Maximilien Djabia
                    </p>
                </div>
            </div>

            <div class="ps-footer-bottom">
                <small>© 2026 ParkShare. Tous droits réservés.</small>
            </div>
        </div>
    </footer>

    {% block script %}
        <script src="{{ url_for('static', filename='js/base.js') }}"></script>
    {% endblock %}
</body>
</html>
