<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <title>{{ Entete }} | ParkShare</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="https://www.cegepgarneau.ca/favicon.ico">
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand ms-5" href="#">ParkShare</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="nav justify-content-center">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item me-2">
                            <a class="nav-link active" aria-current="page" href="#">Accueil</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link" href="#">Rechercher</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link" href="#">comment ça marche ?</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="nav-link" href="#">À propos</a>
                        </li>
                    </ul>
                </div>
                <div class="d-flex me-5">
                    <button class="btn btn-outline-dark me-2" type="button">Se connecter</button>
                    <button class="btn btn-dark me-2" type="button">S'inscrire</button>
                </div>
            </div>
        </nav>
    </header>
      <main class="container">
        {% block contenu %}
        {% endblock %}
    </main>
    <footer>

    </footer>
</body>

</html>