{% extends '_modele.jinja' %}

{%block contenu %}
<div class="container">
    <div class="row">
        <div class="col-9">
            <h1>{{Arguments}}</h1>
            <form action="#">
                <div class="container">
                    <div class="row gap-2">
                        <input class="col-3" type="text" placeholder="Ville" id="txt_ville"/>
                        <input class="col-2" type="date" placeholder="Date de début" id="date_debut"/>
                        <input class="col-2" type="date" placeholder="Date de fin" id="date_fin"/>
                        <input class="col-2 rounded-pill bg-dark text-white" type="submit" placeholder="Rechercher"/>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex">
        <p> {{nb_article}} résultats trouvés</p>
        
    </div>
</div>
{%endblock%}